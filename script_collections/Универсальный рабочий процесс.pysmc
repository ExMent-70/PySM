            {
              "type": "script_set",
              "id": "setnode_a71102a83540",
              "name": "Настройка ЛОКАЛЬНЫХ переменных (один раз для каждого класса(группы)",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/SYSTEM/log_html",
                  "instance_id": "instance_5be42584d5d2",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": null,
                  "command_line_args": {
                    "html_content": {
                      "value": "<b>НАСТРОЙКА ЛОКАЛЬНОГО ОКРУЖЕНИЯ</b>\n<i>(обязательно выполняется для каждого учебного класс/группы)</i><hr>\n<b>wf_session_name</b> - уникальное (неповторяющееся) название класса/группы\n<b>список класса</b> -  текстовый файл <i>wf_session_name.list</i> содержаший подробную информацию о всех участников съемки (ФИО, вид и стоимость фотопродукции, цитата и т.д.)\n\nСписок класса/группы можно РЕДАКТИРОВАТЬ в любое время!",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
