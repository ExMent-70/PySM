                      "value": true,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_89db081d8969",
                  "name": "Завершить блок",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "EXIT",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "dlg_goto_title": {
                      "value": "Выбор следующего действия",
                      "enabled": true
                    },
                    "dlg_goto_message": {
                      "value": "Выберите скрипт, к которому нужно перейти:",
                      "enabled": true
