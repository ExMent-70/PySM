                  "instance_id": "instance_4c1e3da1aa6b",
                  "name": "УСЛОВИЕ: Проверка КАТАЛОГА ШАБЛОНОВ",
                  "description": "<div style=\" {theme.script_description}\">\nСкрипт проверяет наличие переменной <b>wf_idsgn_catalog</b>, которая содержит путь к каталогу шаблонов InDesign.\n\nЕсли переменная не существует, то программа предлагает выбрать файл-каталог шаблонов.\nЕсли переменная существует, то запускается скрипт каталогизатор.\n</div>",
                  "silent_mode": true,
                  "icon_name": "LOGIC_IF",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "if-variable-name": {
                      "value": "wf_idsgn_catalog",
                      "enabled": true
                    },
                    "if-operator": {
                      "value": "равно",
                      "enabled": true
                    },
                    "if-comparison-value": {
                      "value": "None",
                      "enabled": true
                    },
                    "then-instance-id": {
                      "value": "instance_637bfb2d033e",
                      "enabled": true
                    },
                    "else-instance-id": {
                      "value": "instance_6c4854c76464",
                      "enabled": true
                    },
                    "clear-variable": {
                      "value": false,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_open",
                  "instance_id": "instance_637bfb2d033e",
                  "name": "БЛОК ИСТИНА: Открыть файл-каталог шаблонов InDesign",
                  "description": "<div style=\" {theme.markup_number}\">\nСкрипт запускается если не выбран каталог шаблонов InDesign.\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт открывает диалоговое окно для выбора пути к файлу-каталогу шаблонов InDesign.\n\nВыбранный путь сохраняется в переменную контекста <b>wf_idsgn_catalog</b>.\n</div>",
                  "silent_mode": true,
                  "icon_name": "OPEN",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "dlg_open_var": {
                      "value": "wf_idsgn_catalog",
                      "enabled": true
                    },
                    "dlg_open_type": {
                      "value": "file",
                      "enabled": true
                    },
                    "dlg_open_title": {
                      "value": "Выберите файл-каталог шаблонов InDesign",
                      "enabled": true
                    },
                    "dlg_open_filter": {
                      "value": "*.template",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/InDesign/idsgn_catalog",
                  "instance_id": "instance_6c4854c76464",
                  "name": "Выбрать шаблон InDesign",
                  "description": "<div style=\" {theme.script_description}\">Скрипт позволяет выбрать и настроить шаблон InDesign для автоматической генерации фотографий, виньеток и  альбомных разворотов.\n\nНастройки шаблона сохраняются в переменной контекста <b>WF_TEMPLATE_NAME</b></div>",
                  "silent_mode": true,
                  "icon_name": "COPY_INDD",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "idsgn_catalog": {
                      "value": "{wf_idsgn_catalog}",
                      "enabled": true
                    },
                    "idsgn_template_var": {
                      "value": "wf_template_name",
                      "enabled": true
