                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/session_open",
                  "instance_id": "instance_9c5b411f4b79",
                  "name": "Запуск Capture One. Обработка и экспорт выбранных файлов в PSD",
                  "description": "<div style=\" {theme.script_description}\"><b>ВНИМАНИЕ!</b>\nЦветокоррекция фотографий, отобранных клиентом, и их экспорт в формат PSD для дальнейшей ретуши.\n\nПри экспорте используйте рецепт <b>_PSD_8bit_</b>\n</div>",
                  "silent_mode": false,
                  "icon_name": "APP_C1",
                  "icon_color": "#E67E22",
                  "command_line_args": {
                    "__wf_session_file_path": {
                      "value": "{wf_session_path}/{wf_session_name}/{wf_session_name}.cosessiondb",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_msg",
                  "instance_id": "instance_ea81730ecbe7",
                  "name": "Ждем завершения работы Сapture One",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "WARNING",
                  "icon_color": "#E67E22",
                  "command_line_args": {
                    "dlg_msg_var": {
                      "value": "dlg_msg_user_var",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Подтверждение",
                      "enabled": true
                    },
                    "dlg_msg_message": {
                      "value": "Вы завершили работу с программой Capture One?\nУверены, что готовы продолжить?",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/raw2jpeg",
                  "instance_id": "instance_6c57562bfa75",
                  "name": "Конвертировать отобранные файлы из PSD в JPEG",
                  "description": "<div style=\"{theme.script_description}\">\nСкрипт, конвертирует исходные файлы изображений (RAW или PSD) в формат JPEG для последующего анализа другими скриптами.\n\nЕсли ваши изображения уже в формате JPG, то данный скрипт можно не запускать.\n</div>",
                  "silent_mode": false,
                  "icon_name": "CONVER_RAW",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
                      "enabled": true
                    },
                    "output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "a_r2j_image_type": {
                      "value": "psd",
                      "enabled": true
                    },
                    "a_r2j_preview_size": {
                      "value": "2048",
                      "enabled": true
                    },
                    "a_r2j_jpeg_quality": {
                      "value": 95,
                      "enabled": true
                    },
                    "recursive_read": {
                      "value": true,
                      "enabled": true
                    },
                    "keep_structure": {
                      "value": false,
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_analysis",
                  "instance_id": "instance_2743e67f346b",
                  "name": "Обновить атрибуты лиц на отобранных фотографиях",
                  "description": "<div style=\" {theme.script_description}\"><b>ОБНОВЛЕНИЕ КООРДИНАТ</b>\nПосле выбора фотографий обязательно пересчитываем координаты ключевых точек лица.\nЭто необходимо для корректной работы механизма \"умного\" кадрирования и масштабирования в скрипте автоматической верстки.\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "a_af_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "a_af_output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_af_input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "a_af_mode": {
                      "value": "sync",
                      "enabled": true
                    },
                    "a_af_model_name": {
                      "value": "buffalo_l",
                      "enabled": true
                    },
                    "a_af_det_size": {
                      "value": 1280,
                      "enabled": true
                    },
                    "a_af_det_thresh": {
                      "value": "0.4",
                      "enabled": true
                    },
                    "a_af_tasks": {
                      "value": [
                        "gender",
                        "emotion",
                        "age",
                        "beauty",
                        "eyeblink"
                      ],
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/create_xmp",
                  "instance_id": "instance_87e14f606857",
                  "name": "Обновить XMP данные для отобранных файлов PSD",
                  "description": "<div style=\" {theme.script_description}\"><b>ОБНОВЛЕНИЕ КООРДИНАТ</b>\nПосле выбора фотографий обязательно обновляем все XMP данные содержащие координаты (bbox, kps и т.д.)\nЭто необходимо для корректной работы механизма \"умного\" кадрирования и масштабирования в скрипте автоматической верстки.\n </div>",
                  "silent_mode": true,
                  "icon_name": "FILE_XMP",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "image_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
