                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "landmark_enable": {
                      "value": false,
                      "enabled": true
                    },
                    "scan_folder_mode": {
                      "value": true,
                      "enabled": true
                    },
                    "xmp_subfolder": {
                      "value": true,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_c73bb7a8bc66",
                  "name": "Перемещение рабочих файлов в папку Альбом",
                  "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                  "silent_mode": true,
                  "icon_name": "COPY_PSD",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
                      "enabled": true
                    },
                    "do_dest_dir": {
