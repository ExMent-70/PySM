        {
          "type": "set_folder",
          "id": "foldernode_3ce71ff58ab7",
          "name": "Рабочий процесс (для каждой съемки)",
          "description": null,
          "children": [
            {
              "type": "script_set",
              "id": "setnode_708c7f947f22",
              "name": "Этап 1. Подготовка исходных файлов для AI-анализа",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_choice",
                  "instance_id": "instance_b9fd2cb8e9c0",
                  "name": "Выбор съемки (портретная, студийная, школьная и т.д.)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "CAMERA",
                  "icon_color": null,
                  "command_line_args": {
                    "dlg_choice_var": {
                      "value": "wf_photo_session",
                      "enabled": true
                    },
                    "dlg_choice_title": {
                      "value": "Тип, место или дата съемки",
                      "enabled": true
                    },
                    "dlg_choice_message": {
                      "value": "Если договором предусмотрено несколько съемок\n(например: портретная, студийная, школьная и т.д.),\nукажите название текущей съемки.\n\nВыберите название съемки в выпадающем списке:\n",
                      "enabled": true
                    },
                    "dlg_choice_list": {
                      "value": [
                        "PORTRAIT",
                        "SCHOOL",
                        "SEPTEMBER1",
                        "STREET",
                        "STUDIO"
                      ],
                      "enabled": true
                    },
                    "dlg_choice_dvalue": {
                      "value": "wf_photo_session",
                      "enabled": false
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_choice",
                  "instance_id": "instance_fc9b2efa2f1f",
                  "name": "Выбор типа исходных файлов: RAW или JPG",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "SELECT_FILES",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_choice_var": {
                      "value": "var_source_file_type",
                      "enabled": true
                    },
                    "dlg_choice_title": {
                      "value": "Тип исходных файлов",
                      "enabled": true
                    },
                    "dlg_choice_message": {
                      "value": "Какой тип файлов (RAW или JPG)\nвы будете обрабатывать?\n",
                      "enabled": true
                    },
                    "dlg_choice_list": {
                      "value": [
                        "RAW",
                        "JPG"
                      ],
                      "enabled": true
                    },
                    "dlg_choice_dvalue": {
                      "value": "RAW",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_open",
                  "instance_id": "instance_a291f1f7646d",
                  "name": "Выбрать папку с исходными файлами (RAW или JPG)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "FOLDER_OPEN",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_open_var": {
                      "value": "wf_source_file_path",
                      "enabled": true
                    },
                    "dlg_open_type": {
                      "value": "directory",
                      "enabled": true
                    },
                    "dlg_open_title": {
                      "value": "Папка с исходными {var_source_file_type} файлами",
                      "enabled": true
                    },
                    "dlg_open_filter": {
                      "value": "Все файлы (*.*)",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_if_else",
                  "instance_id": "instance_a261503aeac2",
                  "name": "Обрабатываем RAW-файлы? (да/нет)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LOGIC_IF",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "if-variable-name": {
                      "value": "var_source_file_type",
                      "enabled": true
                    },
                    "if-operator": {
                      "value": "равно",
                      "enabled": true
                    },
                    "if-comparison-value": {
                      "value": "RAW",
                      "enabled": true
                    },
                    "then-instance-id": {
                      "value": "instance_405fc193fa5a,instance_2c739ae45371,instance_ddc9a5825b0f",
                      "enabled": true
                    },
                    "else-instance-id": {
                      "value": "instance_261ac90212e1",
                      "enabled": true
                    },
                    "clear-variable": {
                      "value": false,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_405fc193fa5a",
                  "name": "Копировать RAW-файлы  в папку сессии",
                  "description": "<div style=\" {theme.script_description}\">\nСкрипт копирует исходные RAW-файлы в папку Capture.\n</div>",
                  "silent_mode": true,
                  "icon_name": "COPY_RAW",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_source_file_path}",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Capture/{wf_photo_session}",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "copy",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*.cr3"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/raw2jpeg",
                  "instance_id": "instance_2c739ae45371",
                  "name": "Конвертировать RAW в JPEG",
                  "description": "<div style=\"{theme.script_description}\">\nСкрипт, конвертирует исходные файлы изображений (RAW или PSD) в формат JPEG для последующего анализа другими скриптами.\n\nЕсли ваши изображения уже в формате JPG, то данный скрипт можно не запускать.\n</div>",
                  "silent_mode": true,
                  "icon_name": "CONVER_RAW",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Capture/{wf_photo_session}",
                      "enabled": true
                    },
                    "output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "a_r2j_image_type": {
                      "value": "raw",
                      "enabled": true
                    },
                    "a_r2j_preview_size": {
                      "value": "2048",
                      "enabled": true
                    },
                    "a_r2j_jpeg_quality": {
                      "value": 95,
                      "enabled": true
                    },
                    "recursive_read": {
                      "value": false,
                      "enabled": true
                    },
                    "keep_structure": {
                      "value": false,
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_ddc9a5825b0f",
                  "name": "Завершить обработку RAW-файлов",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "EXIT",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_e233278037dc",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_261ac90212e1",
                  "name": "Копировать JPG-файлы в папку сессии",
                  "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                  "silent_mode": true,
                  "icon_name": "COPY_JPG",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_source_file_path}",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "copy",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*.jpg",
                        "*.jpeg"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/img2mask",
                  "instance_id": "instance_e233278037dc",
                  "name": "Создать маски фона",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "FILE_MASK",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "img_rmbg_input_dir": {
