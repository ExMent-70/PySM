                        "image"
                      ],
                      "enabled": true
                    },
                    "img_rmbg_invert_mask": {
                      "value": true,
                      "enabled": true
                    },
                    "img_rmbg_fast_refine": {
                      "value": true,
                      "enabled": true
                    },
                    "img_rmbg_threads": {
