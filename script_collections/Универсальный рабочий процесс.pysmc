              ]
            }
          ]
        },
        {
          "type": "set_folder",
          "id": "foldernode_dfca92314660",
          "name": "Сокращенный рабочий процесс",
          "description": null,
          "children": [
            {
              "type": "script_set",
              "id": "setnode_10c937ebe8d3",
              "name": "Этап JSort. Сортировать JPG-файлы по папкам",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_open",
                  "instance_id": "instance_f3152e0d709a",
                  "name": "ДИАЛОГ: Выбрать папку с JPG-файлами",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "dlg_open_var": {
                      "value": "wf_raw_path",
                      "enabled": true
                    },
                    "dlg_open_type": {
                      "value": "directory",
                      "enabled": true
                    },
                    "dlg_open_title": {
                      "value": "Выбрать папку с исходными файлами",
                      "enabled": true
                    },
                    "dlg_open_filter": {
                      "value": "Все файлы (*.*)",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_16e8292d33e6",
                  "name": "Копировать JPG-файлы в рабочую папку",
                  "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_raw_path}",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "copy",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*",
                        "*.jpg",
                        "*.jpeg"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/analyze_faces",
                  "instance_id": "instance_51963e73e327",
                  "name": "Найти лица на фотографиях. Вычислить эмбединги",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Второй по очереди (но главный по сути) скрипт в конвейере анализа изображений</b> \nСкрипт анализуирует изображения в формате JPG, распознает на них лица людей и переводит их в векторный формат (вычисляет эмбединги). Результаты анализа сохраняются в JSON и NPY-файлы (отдельно для портретных и групповых фотографий).\n\nПути к рабочим папкам формируется из переменных контекста: {wf_session_path}, {wf_session_name} и {wf_photo_session}.\n\n<b>base_dir</b> = <i>{wf_session_path} / {wf_session_name}</i>\n<b>output_dir</b> = <i>{base_dir} / Output / Analysis_{photo_session}</i>\n<b>input_dir</b> = <i>{output_dir} / JPG</i>\n\nСкрипт работает с файлами JPG, поэтому RAW и PSD файлы необходимо предварительно конвертировать.\n</div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "a_af_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": 0,
                      "enabled": true
                    },
                    "a_af_det_thresh": {
                      "value": "0.4",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/analyze_keypoints",
                  "instance_id": "instance_b72492121a06",
                  "name": "Анализ атрибутов лица",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Четвертый (<i>НЕОБАЗЯТЕЛЬНЫЙ</i>) скрипт в конвейере анализа изображений</b> \nСкрипт, на основании вычисленных ключевых точек <i>landmark_2d_106</i> и <i>landmark_3d_68</i>, анализирует атрибуты лица/головы: состояние глаз (открыты/закрыты) и рта (открыт/закрыт), поворота и наклона (вправо/влево/вверх/вниз).\nИнформация добавляется в файл JSON созданный скриптом №2.\n\nПути к рабочим папкам формируется из переменных контекста: {wf_session_path}, {wf_session_name}, {wf_photo_session} и {wf_children_file_name}.\n\n<b>base_dir</b> = <i>{wf_session_path} / {wf_session_name}</i> \n<b>data_dir</b> = <i>{base} / Output / Analysis_{wf_photo_session}</i>\n\nЕсли эти данные не нужны, то скрипт можно удалить из рабочеого процесса\n</div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "a_ak_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/cluster_portraits",
                  "instance_id": "instance_cb4bc3f8c50e",
                  "name": "Кластеризация портретных фотографий",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "a_cp_portrait_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                      "enabled": true
                    },
                    "a_cp_names_file": {
                      "value": "{wf_session_path}/{wf_session_name}/{wf_photo_session}_{wf_children_file_name}",
                      "enabled": true
                    },
                    "a_cp_config": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "a_cp_algorithm": {
                      "value": "dbscan",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/cluster_editor",
                  "instance_id": "instance_7357400203e1",
                  "name": "Редактировать портретные кластеры",
                  "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ПОРТРЕТНЫХ фотографий (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session},\n- {wf_children_file_name}.\n</div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "ce_portrait_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                      "enabled": true
                    },
                    "ce_group_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                      "enabled": true
                    },
                    "mode": {
                      "value": "face",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/match_group_faces",
                  "instance_id": "instance_5a7864f9710c",
                  "name": "Идентификация людей на групповых фотографиях используя ПОРТРЕТЫ ТЕКУЩЕЙ фотосессии",
                  "description": "Выполнение этих скриптов приведёт к созданию и/или изменению следующих файлов:\n- info_group_faces.json\n- info_portrait_faces.json\n- matches_portrait_to_group.json",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "a_mg_portrait_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                      "enabled": true
                    },
                    "a_mg_group_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                      "enabled": true
                    },
                    "a_mg_config": {
                      "value": "config.toml",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/cluster_editor",
                  "instance_id": "instance_f4fd21fe6017",
                  "name": "Просмотр и экспорт списка [ПОРТРЕТ-Групповые фотографии]",
                  "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается в случае, когда  в текущей фотосессии ЕСТЬ портретные фотографии\n</div>\n<div style=\" {theme.script_description}\">\nЗапуск Редактора кластеров в режиме просмотра фотографий  [ПОРТРЕТ-Групповые фотографии]\n\nДля идентификации людей на групповых фотографиях текущей фотосессии <b>{wf_photo_session}</b> используются ПОРТРЕТЫ текущей фотосессии.\n\n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session}\n</div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "ce_portrait_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                      "enabled": true
                    },
                    "ce_group_json": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                      "enabled": true
                    },
                    "mode": {
                      "value": "matches",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_78fef06cf231",
                  "name": "Перемещение экспортированных JPG-файлов (портреты)",
                  "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается если в Редакторе кластеров выполнялась операция экспорта фотографий в JPG-файлы.\nПеременная контекста <i>var_jpg_move = yes</i>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт перемещает отсортированные по папкам JPG-файлы  (c потретными и/или групповыми фотографиями) в указанную папку (например на Яндекс-диск).\n</div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}/Выбор_Фото_{wf_photo_session}_face",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "move",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*.jpg"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "8",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_0991757d2726",
                  "name": "Перемещение экспортированных JPG-файлов (групповые фото)",
                  "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается если в Редакторе кластеров выполнялась операция экспорта фотографий в JPG-файлы.\nПеременная контекста <i>var_jpg_move = yes</i>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт перемещает отсортированные по папкам JPG-файлы  (c потретными и/или групповыми фотографиями) в указанную папку (например на Яндекс-диск).\n</div>",
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}/Выбор_Фото_{wf_photo_session}_matches",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "move",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*.jpg"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "8",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/wf_raw_create_xmp",
                  "instance_id": "instance_c8375884fcb1",
                  "name": "Создать XMP-файлы",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "image_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG/_XMP_",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": 8,
                      "enabled": true
                    },
                    "landmark_enable": {
                      "value": false,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/analize/generate_report",
                  "instance_id": "instance_7a515c0e414f",
                  "name": "Создать HTML-отчет",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {}
                }
              ]
            }
          ]
        }
      ]
    }
