            {
              "type": "script_set",
              "id": "setnode_0c9832b28492",
              "name": "ПРОЦЕСС: Инициализация флагов кластеризации",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/SYSTEM/log_html",
                  "instance_id": "instance_a90bb12502b3",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "html_content": {
                      "value": "<div style=\" {theme.script_description}\"><b>НАСТРОЙКА ОКРУЖЕНИЯ</b>\n<i>(локальные переменные для текущей фотосъемки)</i>\n\n<b>wf_temp_tech_claster = {wf_temp_tech_claster}</b> - флаг выполнения технической кластеризации фотографий\n<b>wf_temp_portrait_claster = {wf_temp_portrait_claster}</b> - флаг выполнения кластеризации портретных фотографий\n<b>wf_temp_location_claster = {wf_temp_location_claster}</b> - флаг выполнения кластеризации фотографий по сюжетам\n<b>wf_temp_matches_claster = {wf_temp_matches_claster}</b> - флаг идентификации лиц на групповых фотограиях\n\nПри настройке окружения всем флагам присваивается значение <i>no</i> - соответствующий этап клестеризации не выполнялся</div>",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": 5,
                      "enabled": true
                    },
                    "html_padding": {
                      "value": 10,
                      "enabled": true
                    },
                    "html_style": {
                      "value": "",
                      "enabled": true
                    }
                  }
                },
                {
