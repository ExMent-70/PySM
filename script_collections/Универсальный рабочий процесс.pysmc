            {
              "type": "script_set",
              "id": "setnode_3f0712c60287",
              "name": "Этап 2. Определение лиц на фотографиях",
              "description": null,
              "script_entries": [
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_analysis",
                  "instance_id": "instance_ebcbcf9cb8b1",
                  "name": "Найти все лица на изображениях. Вычислить эмбединги",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Основной скрипт в конвейере анализа изображений</b> \nСкрипт анализирует изображения в формате JPG, распознает на них лица людей и переводит их в векторный формат (вычисляет эмбединги). \n\nРезультаты AI-анализа сохраняются в оптимизированном формате в <b>JSON и NPY-файлы:</b> основные метаданные и тяжелая геометрия (ландмарки) разделены по разным файлам для ускорения работы.\n\nСкрипт работает только с файлами JPG, поэтому RAW и PSD файлы необходимо предварительно конвертировать.\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT",
                  "icon_color": null,
                  "command_line_args": {
                    "a_af_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "a_af_output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_af_input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "a_af_mode": {
                      "value": "create",
                      "enabled": true
                    },
                    "a_af_model_name": {
                      "value": "buffalo_l",
                      "enabled": true
                    },
                    "a_af_det_size": {
                      "value": 1280,
                      "enabled": true
                    },
                    "a_af_det_thresh": {
                      "value": "0.4",
                      "enabled": true
                    },
                    "a_af_tasks": {
                      "value": [
                        "gender",
                        "emotion",
                        "age",
                        "beauty",
                        "eyeblink"
                      ],
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_keypoints",
                  "instance_id": "instance_a97adb8a12ab",
                  "name": "Дополнительный анализ лиц",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Необязательный скрипт в конвейере анализа изображений</b> \nСкрипт, на основании вычисленных ключевых точек <i>landmark_2d_106</i> и <i>landmark_3d_68</i>, анализирует атрибуты лица/головы: состояние глаз (открыты/закрыты) и рта (открыт/закрыт), поворот и наклон (вправо/влево/вверх/вниз).\n\nПолученные данные сохраняются в файл <b>info_face.json</b>.\n\nЕсли эти данные не нужны, то скрипт можно удалить из рабочеого процесса\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT_EDIT",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "a_ak_data_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_ak_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_dcb579d431d1",
                  "name": "Инициализация флагов кластеризации",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "VAR_SET",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_a90bb12502b3,instance_430c30b30eb0,instance_8d25a0991024,instance_0aaa29f52a2e,instance_13553984695a",
                      "enabled": true
                    }
                  }
                }
              ]
            },
