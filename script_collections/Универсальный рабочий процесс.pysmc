                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_open",
                  "instance_id": "instance_2a57fb392b72",
                  "name": "Файл-каталог шаблонов InDesign",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "VAR_SET",
                  "icon_color": "#3498DB",
                  "command_line_args": {
