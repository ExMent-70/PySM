{
  "type": "script_set",
  "id": "setnode_c1a3a47a21b2",
  "name": "Этап 4-JPG. Копирование JPG файлов в папку верстки альбома (для каждой фотосессии)",
  "description": null,
  "script_entries": [
    {
      "id": "root_790d968b/Workflow/analize/wf_photo_copy",
      "instance_id": "instance_97917198217d",
      "name": "Отметить фотографии выбранные клиентами (JPG файлы)",
      "description": "<div style=\" {theme.script_description}\">\nСкрипт идентифицирует в неструктурированном тексте номера фотографий выбранных пользователем.\n\nЗатем ищет в исходной папке JPG-файлы, в именах которых содержатся указанные номера. \n\nВ настройках скрипта установлены опции копирования и переименования найденных файлов в целевую папку.\n</div>",
      "silent_mode": false,
      "command_line_args": {
        "portrait_json": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
          "enabled": true
        },
        "group_json": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
          "enabled": true
        },
        "source_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
          "enabled": true
        },
        "dest_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
          "enabled": true
        },
        "min_digits": {
          "value": "4",
          "enabled": true
        },
        "max_digits": {
          "value": "4",
          "enabled": true
        },
        "exclude_dirs": {
          "value": "Masks",
          "enabled": true
        },
        "update-xmp": {
          "value": false,
          "enabled": true
        },
        "rename-files": {
          "value": true,
          "enabled": true
        },
        "copy-files": {
          "value": true,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/dir_operation",
      "instance_id": "instance_87bff58645c3",
      "name": "Перемещение файлов JPG в папку Альбом",
      "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
      "silent_mode": false,
      "command_line_args": {
        "do_source_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
          "enabled": true
        },
        "do_dest_dir": {
          "value": "{wf_psd_path}/{wf_session_name}",
          "enabled": true
        },
        "do_mode": {
          "value": "move",
          "enabled": true
        },
        "do_on_conflict": {
          "value": "overwrite",
          "enabled": true
        },
        "do_copy_base_folder": {
          "value": false,
          "enabled": true
        },
        "do_include": {
          "value": [
            "*.jpg",
            "*.jpeg"
          ],
          "enabled": true
        },
        "all_threads": {
          "value": "8",
          "enabled": true
        }
      }
    }
  ]
}