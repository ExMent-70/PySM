      "instance_id": "instance_396a7945e661",
      "name": "Выбор съемки (портретная, студийная, школьная и т.д.)",
      "description": null,
      "silent_mode": false,
      "command_line_args": {
        "dlg_choice_var": {
          "value": "wf_photo_session",
          "enabled": true
        },
        "dlg_choice_title": {
          "value": "Выбор съемки",
          "enabled": true
        },
        "dlg_choice_message": {
          "value": "Если договором предусмотрено несколько съемок\n(например: портретная, студийная, школьная и т.д.),\nукажите название текущей съемки.\n\nВыберите название съемки в выпадающем списке:\n",
          "enabled": true
        },
        "dlg_choice_list": {
          "value": [
            "PORTRAIT",
            "SCHOOL",
            "SEPTEMBER1",
            "STREET",
            "STUDIO"
          ],
          "enabled": true
        },
        "dlg_choice_dvalue": {
          "value": "",
          "enabled": false
        }
      }
    },
    {
      "id": "root_790d968b/Workflow/wf_list_create",
      "instance_id": "instance_c07a0f9a1b32",
      "name": "Добавить порядковый номер съемки в список класса/группы",
      "description": null,
      "silent_mode": false,
      "command_line_args": {
