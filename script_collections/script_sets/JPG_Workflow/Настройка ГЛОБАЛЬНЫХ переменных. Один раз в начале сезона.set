{
  "type": "script_set",
  "id": "setnode_0ae79a257d86",
  "name": "Настройка ГЛОБАЛЬНЫХ переменных. Один раз в начале сезона",
  "description": null,
  "script_entries": [
    {
      "id": "root_7617c03c/GUI/gui_dialog_open",
      "instance_id": "instance_08736a0c394a",
      "name": "ПЕРЕМЕННАЯ: Выбрать базовую папку для исходных файлов",
      "description": "<div style=\" {theme.script_description}\">\nВыбрать <b>общую папку</b>, в которой будут храниться <b>ИСХОДНЫЕ ФАЙЛЫ</b> (обычно RAW или JPG) каждого класса/группы. . \n\nПуть к общей папке сохраняется в переменной <b>{wf_session_path}</b>.\n\nПеременная <b>{wf_session_path}</b> используется для формирования шаблонов путей.\n\n<b>Например:</b>\n<i>- {wf_session_path}/School_32/Capture</i>\n<i>- {wf_session_path}/School_32/children.txt</i>\n</div>",
      "silent_mode": false,
      "command_line_args": {
        "dlg_open_var": {
          "value": "wf_session_path",
          "enabled": true
        },
        "dlg_open_type": {
          "value": "directory",
          "enabled": true
        },
        "dlg_open_title": {
          "value": "Выбрать базовую папку для всех RAW-файлов/сессий Capture One",
          "enabled": true
        },
        "dlg_open_filter": {
          "value": "Все файлы (*.*)",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_open",
      "instance_id": "instance_6a386c7daea8",
      "name": "ПЕРЕМЕННАЯ: Выбрать базовую папку для рабочих файлов",
      "description": "<div style=\" {theme.script_description}\">\nВыбрать <b>общую папку</b>, в которой будут храниться <b>РАБОЧИЕ ФАЙЛЫ</b> (обычно JPG, PSD, INDD и т.д.) каждого класса/группы. \n\nПуть к общей папке сохраняется в переменной <b>{wf_psd_path}</b>.\n\nПеременная <b>{wf_psd_path}</b>  используется для формирования шаблонов путей.\n\n<b>Например:</b>\n<i>- {wf_psd_path}/Школа8_1д/Школа8_1д_класс.list</i>\n<i>- {wf_psd_path}/School_32/Альбом/_ШАБЛОНЫ_</i>\n</div>",
      "silent_mode": false,
      "command_line_args": {
        "dlg_open_var": {
          "value": "wf_psd_path",
          "enabled": true
        },
        "dlg_open_type": {
          "value": "directory",
          "enabled": true
        },
        "dlg_open_title": {
          "value": "Выбрать базовую папку для PSD-файлов (в нее будут скопированны PSD-файлы текущей сессии)",
          "enabled": true
        },
        "dlg_open_filter": {
          "value": "Все файлы (*.*)",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_input",
      "instance_id": "instance_7cef740fce1f",
      "name": "ПЕРЕМЕННАЯ: Имя файла со списком для фотосессии",
      "description": "<div style=\" {theme.script_description}\">\nВвести <b>имя текстового файла</b> для списка учеников класса (по умолчанию <b>children.txt</b>). \n\nИмя файла сохраняется в переменной <b>{wf_children_file_name}</b>.\n\nПеременная <b>{wf_children_file_name}</b> необходима для работы скриптов кластеризации и используется для формирования шаблонов путей.\n\n<b>Например:</b>\n<i>- {wf_psd_path}/Школа8_1д/{wf_children_file_name}</i>\n</div>",
      "silent_mode": false,
      "command_line_args": {
        "dlg_input_var": {
          "value": "wf_children_file_name",
          "enabled": true
        },
        "dlg_input_title": {
          "value": "Ввод значения",
          "enabled": true
        },
        "dlg_input_msg": {
          "value": "Введите имя файла, со списком для фотосессии.\n\nНапример, children.txt",
          "enabled": true
        },
        "dlg_input_dvalue": {
          "value": "children.txt",
          "enabled": true
        },
        "dlg_input_valid_type": {
          "value": "filename_txt",
          "enabled": true
        },
        "dlg_input_custom_regexp": {
          "value": null,
          "enabled": true
        },
        "dlg_input_custom_regexp_desc": {
          "value": null,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_open",
      "instance_id": "instance_9db9997018d2",
      "name": "ПЕРЕМЕННАЯ: Файл-каталог шаблонов InDesign",
      "description": "<div style=\" {theme.script_description}\">\nВыбрать <b>каталог шаблонов</b> InDesign (файл с расширением <b>*.template</b>). \n\nПуть к файлу-каталогу сохраняется в переменной <b>{wf_idsgn_catalog}</b>.\n\nПеременная <b>{wf_idsgn_catalog}</b>  необходима для работы скриптов \"Каталог шаблонов\" и \"Автоматическая верстка\" и используется для формирования шаблонов путей. \n</div>",
      "silent_mode": false,
      "command_line_args": {
        "dlg_open_var": {
          "value": "wf_idsgn_catalog",
          "enabled": true
        },
        "dlg_open_type": {
          "value": "file",
          "enabled": true
        },
        "dlg_open_title": {
          "value": "Выберите файл-каталог шаблонов InDesign",
          "enabled": true
        },
        "dlg_open_filter": {
          "value": "*.template",
          "enabled": true
        }
      }
    }
  ]
}