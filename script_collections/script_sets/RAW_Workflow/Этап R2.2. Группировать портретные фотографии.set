          "value": true,
          "enabled": true
        }
      }
    },
    {
      "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_face2",
      "instance_id": "instance_bb748e0c6dd3",
      "name": "Кластеризация портретных фотографий",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "a_target_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
          "enabled": true
        },
        "a_mode": {
          "value": "face",
          "enabled": true
        },
        "a_sim_threshold": {
          "value": "0.25",
          "enabled": true
        },
        "a_metric": {
          "value": "cosine",
          "enabled": true
        },
        "a_clear_min_score": {
          "value": 0.6,
          "enabled": false
        },
        "a_clear_min_abs_area": {
          "value": 2500,
          "enabled": false
        },
        "a_clear_min_rel_area": {
          "value": "0.001",
          "enabled": false
        },
        "a_clear_min_claster_size": {
          "value": "5",
          "enabled": true
        },
        "a_algorithm": {
          "value": "dbscan",
          "enabled": true
        },
        "a_ref_dir": {
          "value": null,
          "enabled": false
        },
        "a_hdb_cluster_selection_epsilon": {
          "value": 0.0,
          "enabled": false
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/cli_var_set",
      "instance_id": "instance_1b9a74d726da",
      "name": "ПЕРЕМЕННАЯ: wf_temp_portrait_claster = yes",
      "description": "<div style=\" {theme.script_description}\">\nСброс флага выполнения операции кластеризации портретных фотографий.\n<b>wf_temp_matches_claster = no</b>\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "set_var_name": {
          "value": "wf_temp_portrait_claster",
          "enabled": true
        },
        "set_var_value": {
          "value": "yes",
          "enabled": true
        },
        "set_valid_type": {
          "value": "not_empty",
          "enabled": true
        },
        "set_custom_regexp": {
          "value": null,
          "enabled": false
        },
        "set_custom_regexp_desc": {
          "value": null,
          "enabled": false
        }
      }
    },
    {
      "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_editor",
      "instance_id": "instance_051222df3d6b",
      "name": "Редактировать портретные кластеры",
      "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ПОРТРЕТНЫХ фотографий (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "ce_working_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
          "enabled": true
        },
        "ce_reference_dir": {
          "value": "",
          "enabled": true
        },
        "all_threads": {
          "value": "12",
          "enabled": true
        },
        "mode": {
          "value": "face",
          "enabled": true
        }
      }
    }
  ]
}