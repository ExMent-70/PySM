      "name": "УСЛОВИЕ: Необходимость группировки портретных фотографий",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "wf_temp_portrait_claster",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "yes",
          "enabled": true
