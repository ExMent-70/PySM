          "value": "instance_bb748e0c6dd3",
          "enabled": true
        },
        "clear-variable": {
          "value": false,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_msg",
      "instance_id": "instance_ce980f1f4f2b",
      "name": "СООБЩЕНИЕ: Группировка портретных фотографий",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "dlg_msg_var": {
          "value": "var_run_script",
          "enabled": true
        },
        "dlg_msg_type": {
          "value": "yes_no_cancel",
          "enabled": true
        },
        "dlg_msg_title": {
          "value": "Сообщение",
          "enabled": true
        },
        "dlg_msg_message": {
          "value": "Кластеризация портретных фотографий уже выполнялась.\n\nПовторное выполнение этой операции приведёт к изменению файла info_faces.json\n\nВы хотите выполнить скрипт повторно?",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/py_if_else",
      "instance_id": "instance_ee12aa67abb2",
      "name": "УСЛОВИЕ: Повторный запуск кластеризации портретных фотографий",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "var_run_script",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "yes",
          "enabled": true
        },
