  "name": "Этап R2.3. Групировать фотографии по сюжетам",
  "description": null,
  "script_entries": [
    {
      "id": "root_7617c03c/SYSTEM/py_if_else",
      "instance_id": "instance_e54e52e11083",
      "name": "УСЛОВИЕ: Необходимость группировки фотографий по сюжетам",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "wf_temp_location_claster",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "yes",
          "enabled": true
        },
        "then-instance-id": {
          "value": "instance_ca04e3b83d36",
          "enabled": true
        },
        "else-instance-id": {
          "value": "instance_16e406c5f3e1",
          "enabled": true
        },
        "clear-variable": {
          "value": false,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_msg",
      "instance_id": "instance_ca04e3b83d36",
      "name": "СООБЩЕНИЕ: Группировка фотографий по сюжетам",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "dlg_msg_var": {
          "value": "var_run_script",
          "enabled": true
        },
        "dlg_msg_type": {
          "value": "yes_no_cancel",
          "enabled": true
        },
        "dlg_msg_title": {
          "value": "Сообщение",
          "enabled": true
        },
        "dlg_msg_message": {
          "value": "Кластеризация фотографий по сюжетам уже выполнялась.\n\nПовторное выполнение этой операции приведёт приведёт к изменению следующих файлов:\n- location_embeddings.npy\n- info_faces.json\n\nВы хотите выполнить скрипт повторно?",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/py_if_else",
      "instance_id": "instance_adcf7f452b82",
      "name": "УСЛОВИЕ: Повторный запуск кластеризации фотографий по сюжетам",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "var_run_script",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "yes",
          "enabled": true
        },
        "then-instance-id": {
          "value": "instance_16e406c5f3e1",
          "enabled": true
        },
        "else-instance-id": {
          "value": "instance_bbe407ae71bf",
          "enabled": true
        },
        "clear-variable": {
          "value": true,
          "enabled": true
        }
      }
    },
    {
      "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_locations2",
      "instance_id": "instance_16e406c5f3e1",
      "name": "Группировать фотографии по сюжетам",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "mode": {
          "value": "clustering",
          "enabled": true
        },
        "a_cl_data_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
          "enabled": true
        },
        "a_cl_config_file": {
          "value": "config.toml",
          "enabled": true
        },
        "use_originals": {
          "value": false,
          "enabled": true
        },
        "match_threshold": {
          "value": "0.09",
          "enabled": true
        },
        "a_cl_location_prompts": {
          "value": [
            "A student's full-length portrait against a map background",
            "A photo of two students sitting at a school desk",
            "A group photo of children (4 or more people) against a light background",
            "A horizontal photo of children (4 or more people) against a graffiti background. The children are standing or sitting on a chair and a stepladder",
            "A vertical photo of 2-3 students standing or sitting on a stepladder against a graffiti background",
            "A photo of a class on a narrow staircase"
          ],
          "enabled": true
        },
        "a_cl_cluster_eps": {
          "value": "0.14",
          "enabled": true
        },
        "a_cl_mask_suffix": {
          "value": "_BiRefNet-portrait_output.jpg",
          "enabled": true
        },
        "all_threads": {
          "value": "12",
          "enabled": true
        },
        "batch_size": {
          "value": 32,
          "enabled": true
        },
        "cache_mode": {
          "value": "use",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/cli_var_set",
      "instance_id": "instance_fc4a7cea3533",
      "name": "ПЕРЕМЕННАЯ: wf_temp_location_claster = yes",
      "description": "<div style=\" {theme.script_description}\">\nСброс флага выполнения операции кластеризации портретных фотографий.\n<b>wf_temp_matches_claster = no</b>\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "set_var_name": {
          "value": "wf_temp_location_claster",
          "enabled": true
        },
        "set_var_value": {
          "value": "yes",
          "enabled": true
        },
        "set_valid_type": {
          "value": "not_empty",
          "enabled": true
        },
        "set_custom_regexp": {
          "value": null,
          "enabled": false
        },
        "set_custom_regexp_desc": {
          "value": null,
          "enabled": false
        }
      }
    },
    {
      "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_editor",
      "instance_id": "instance_bbe407ae71bf",
      "name": "Редактировать кластеры сюжетов",
      "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ЛОКАЦИЙ (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "ce_working_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
          "enabled": true
        },
        "ce_reference_dir": {
          "value": "",
          "enabled": true
        },
        "all_threads": {
          "value": "12",
          "enabled": true
        },
        "mode": {
          "value": "location",
          "enabled": true
        }
      }
    }
  ]
}
