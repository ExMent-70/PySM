{
  "type": "script_set",
  "id": "setnode_37e59bd1c37f",
  "name": "Этап R2.6. Копировать JPG-файлы с водяными знаками",
  "description": null,
  "script_entries": [
    {
      "id": "root_7617c03c/SYSTEM/py_if_else",
      "instance_id": "instance_2c4ef4d4c03c",
      "name": "УСЛОВИЕ: Экспорт JPG-файлов в Редакторе кластеров (да/нет)",
      "description": "<div style=\" {theme.script_description}\">\nСкрипт проверяет переменную <b>var_jpg_move</b>, которая содержит информацию о выполнении операции экспорта фотографий в файлы JPG в Редакторе кластеров.\n\nЕсли <b>var_jpg_move = yes</b>, то запускается скрипт перемещения экспортированных JPG-файлов в указанную папку  на Яндекс-диск (для отправки родителям)\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "var_jpg_move",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "1",
          "enabled": true
        },
        "then-instance-id": {
          "value": "instance_172547e6e413",
          "enabled": true
        },
        "else-instance-id": {
          "value": "instance_d5b96e5d90e0",
          "enabled": true
        },
        "clear-variable": {
          "value": true,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/dir_operation",
      "instance_id": "instance_172547e6e413",
      "name": "БЛОК ИСТИНА: Перемещение экспортированных JPG-файлов",
      "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается если в Редакторе кластеров выполнялась операция экспорта фотографий в JPG-файлы.\nПеременная контекста <i>var_jpg_move = yes</i>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт перемещает отсортированные по папкам JPG-файлы  (c потретными и/или групповыми фотографиями) в указанную папку (например на Яндекс-диск).\n</div>",
      "silent_mode": false,
      "command_line_args": {
        "do_source_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
          "enabled": true
        },
        "do_dest_dir": {
          "value": "{wf_psd_path}/{wf_session_name}",
          "enabled": true
        },
        "do_mode": {
          "value": "move",
          "enabled": true
        },
        "do_on_conflict": {
          "value": "overwrite",
          "enabled": true
        },
        "do_copy_base_folder": {
          "value": false,
          "enabled": true
        },
        "do_include": {
          "value": [
            "*.jpg"
          ],
          "enabled": true
        },
        "all_threads": {
          "value": "8",
          "enabled": true
        }
      }
    },
    {
      "id": "root_790d968b/Workflow2/Tools/session_report",
      "instance_id": "instance_5918541d8e4e",
      "name": "Информационная панель",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "template": {
          "value": "dashboard",
          "enabled": true
        },
        "scope": {
          "value": null,
          "enabled": true
        },
        "icon_size_tree": {
          "value": 24,
          "enabled": true
        },
        "icon_size_dashboard": {
          "value": "40",
          "enabled": true
        }
      }
    }
  ]
}