    },
    {
      "id": "root_790d968b/Photoshop/ps_action_batch_set_select",
      "instance_id": "instance_65a8c2e70551",
      "name": "Экшен - Универсальный пакетный запуск",
      "description": null,
      "silent_mode": false,
      "command_line_args": {
        "ps_mode": {
          "value": "selected_file_folder",
          "enabled": true
        },
        "ps_file_path": {
