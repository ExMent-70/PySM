        "ps_recursive": {
          "value": true,
          "enabled": true
        },
        "ps_action_set": {
          "value": "PySM_Actions",
          "enabled": true
        },
        "ps_action_name": {
          "value": "PySM_RETUCHE_RUN",
          "enabled": true
        },
        "ps_need_save": {
          "value": true,
          "enabled": true
        },
        "ps_wait_after_action": {
          "value": "2",
          "enabled": true
        }
      }
    },
    {
      "id": "root_790d968b/Photoshop/ps_document_close",
