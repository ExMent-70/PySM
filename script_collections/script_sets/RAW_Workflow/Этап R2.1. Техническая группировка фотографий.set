      "name": "УСЛОВИЕ: Необходимость технической группировки фотографий",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "wf_temp_matches_claster",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "yes",
          "enabled": true
        },
        "then-instance-id": {
          "value": "instance_2ab81811cb3d",
          "enabled": true
        },
        "else-instance-id": {
          "value": "instance_28c4c9692a63",
          "enabled": true
        },
        "clear-variable": {
          "value": false,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_msg",
      "instance_id": "instance_2ab81811cb3d",
      "name": "СООБЩЕНИЕ: Необходимость технической группировки фотографий",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
