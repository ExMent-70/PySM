      "instance_id": "instance_e8b4b763137d",
      "name": "ПЕРЕМЕННАЯ: wf_temp_matches_claster = yes",
      "description": "<div style=\" {theme.script_description}\">\nСброс флага выполнения операции кластеризации портретных фотографий.\n<b>wf_temp_matches_claster = no</b>\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "set_var_name": {
          "value": "wf_temp_matches_claster",
          "enabled": true
        },
        "set_var_value": {
          "value": "yes",
          "enabled": true
        },
        "set_valid_type": {
          "value": "not_empty",
          "enabled": true
        },
        "set_custom_regexp": {
          "value": null,
          "enabled": false
        },
        "set_custom_regexp_desc": {
          "value": null,
          "enabled": false
