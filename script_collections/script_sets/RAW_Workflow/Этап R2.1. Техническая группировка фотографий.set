          "value": "Сообщение",
          "enabled": true
        },
        "dlg_msg_message": {
          "value": "Техническая кластеризация фотографий для удаления \"мусорных\" лиц уже выполнялась.\n\nПовторное выполнение этой операции приведёт к изменению файлов \n- faces_embeddings.npy\n- info_faces.json\n\nВы хотите выполнить скрипт повторно?",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/py_if_else",
      "instance_id": "instance_787f22a493a7",
      "name": "УСЛОВИЕ: Повторный запуск технической кластеризации",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "var_run_script",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "yes",
          "enabled": true
        },
        "then-instance-id": {
          "value": "instance_28c4c9692a63",
          "enabled": true
        },
        "else-instance-id": {
          "value": "instance_706c4c67dc94",
          "enabled": true
        },
        "clear-variable": {
          "value": true,
          "enabled": true
        }
      }
    },
    {
      "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_face2",
      "instance_id": "instance_28c4c9692a63",
      "name": "Техническая кластеризация и фильтрация \"мусорных лиц\"",
      "description": null,
      "silent_mode": false,
      "command_line_args": {
        "a_target_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
          "enabled": true
