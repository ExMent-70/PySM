{
  "type": "script_set",
  "id": "setnode_7ccb7f79195b",
  "name": "Этап 3.5. Копирование JPG-файлов с водяными знаками",
  "description": null,
  "script_entries": [
    {
      "id": "root_7617c03c/SYSTEM/py_if_else",
      "instance_id": "instance_9b74988a6a8c",
      "name": "УСЛОВИЕ: Наличие миниатюр с водяными знаками (да/нет)",
      "description": "<div style=\" {theme.script_description}\">\nСкрипт проверяет переменную <b>var_jpg_move</b>, которая содержит информацию о выполнении операции экспорта фотографий в файлы JPG с водяными знаками.\n\nЕсли <b>var_jpg_move = yes</b>, то запускается скрипт перемещения файлов  JPG на Яндекс-диск (для отправки родителям)\n</div>",
      "silent_mode": true,
      "command_line_args": {
        "if-variable-name": {
          "value": "var_jpg_move",
          "enabled": true
        },
        "if-operator": {
          "value": "равно",
          "enabled": true
        },
        "if-comparison-value": {
          "value": "1",
          "enabled": true
        },
        "then-instance-id": {
          "value": "instance_a69cb1164032",
          "enabled": true
        },
        "else-instance-id": {
          "value": "instance_c7bb5236c429",
          "enabled": true
        },
        "clear-variable": {
          "value": true,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/dir_operation",
      "instance_id": "instance_a69cb1164032",
      "name": "БЛОК ИСТИНА: Перемещение файлов JPG в папку для выбора",
      "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается если раньше была выполнена операция экспорта фотографий в файлы JPG с водяными знаками.\nПеременная контекста <i>var_jpg_move = yes</i>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт перемещает отсортированные папки с файлами JPG (c потретными и/или фотографиями с водяными знаками) на Яндекс-диск.\n</div>",
      "silent_mode": false,
      "command_line_args": {
        "do_source_dir": {
          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
          "enabled": true
        },
        "do_dest_dir": {
          "value": "{wf_psd_path}/{wf_session_name}",
          "enabled": true
        },
        "do_mode": {
          "value": "move",
          "enabled": true
        },
        "do_on_conflict": {
          "value": "overwrite",
          "enabled": true
        },
        "do_copy_base_folder": {
          "value": false,
          "enabled": true
        },
        "do_include": {
          "value": "*.jpg",
          "enabled": true
        },
        "all_threads": {
          "value": "8",
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/SYSTEM/log_report",
      "instance_id": "instance_c7bb5236c429",
      "name": "Информационная панель",
      "description": null,
      "silent_mode": true,
      "command_line_args": {}
    }
  ]
}