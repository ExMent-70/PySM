{
  "type": "script_set",
  "id": "setnode_a71102a83540",
  "name": "Настройка ЛОКАЛЬНЫХ переменных (один раз для каждого класса(группы)",
  "description": null,
  "script_entries": [
    {
      "id": "root_7617c03c/SYSTEM/log_html",
      "instance_id": "instance_03caf48425f9",
      "name": "Информационное сообщение",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "html_content": {
          "value": "<div style=\" {theme.script_description}\">\n<b>НАСТРОЙКА ОКРУЖЕНИЯ</b>\n<i>(локальные переменные, структура рабочих папок)</i>\n\n<b>wf_session_name</b> - уникальное название школы/параллели/класса\n\n<b>wf_temp_tech_claster</b> - флаг выполнения технической кластеризации фотографий\n<b>wf_temp_portrait_claster</b> - флаг выполнения кластеризации портретных фотографий\n<b>wf_temp_location_claster</b> - флаг выполнения кластеризации фотографий по сюжетам\n<b>wf_temp_matches_claster</b> - флаг идентификации лиц на групповых фотограиях\n\nПри настройке окружения всем флагам присваивается значение <i>no</i> - соответствующий этап клестеризации не выполнялся\n</div>\n",
          "enabled": true
        },
        "html_file": {
          "value": null,
          "enabled": false
        },
        "html_align": {
          "value": "left",
          "enabled": true
        },
        "html_margin": {
          "value": 5,
          "enabled": true
        }
      }
    },
    {
      "id": "root_7617c03c/GUI/gui_dialog_input",
      "instance_id": "instance_ec99ca4859ce",
      "name": "ПЕРЕМЕННАЯ: Указать школу/параллель/класс",
      "description": null,
      "silent_mode": true,
      "command_line_args": {
        "dlg_input_var": {
          "value": "wf_session_name",
          "enabled": true
        },
        "dlg_input_title": {
          "value": "Ввод значения",
          "enabled": true
        },
        "dlg_input_msg": {
          "value": "Укажите название школы, параллель и класс.\n\nНапример, Школа56_4а_класс",
          "enabled": true
        },
        "dlg_input_dvalue": {
          "value": "Школа56_4а_класс",
          "enabled": true
        },
        "dlg_input_valid_type": {
          "value": "not_empty",
          "enabled": true
        },
        "dlg_input_custom_regexp": {
          "value": null,
          "enabled": false
        },
        "dlg_input_custom_regexp_desc": {
          "value": null,
          "enabled": false
        }
      }
    },
    {
