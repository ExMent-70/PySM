                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_if_else",
                  "instance_id": "instance_1bf4cb39aaa7",
                  "name": "Повторить операцию копирования (да/нет)?",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LOGIC_IF",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "if-variable-name": {
                      "value": "var_raw_multi_folder",
