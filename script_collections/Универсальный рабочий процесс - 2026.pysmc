                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/batch_rename",
                  "instance_id": "instance_f12e62144b77",
                  "name": "Переименовать исходные RAW-файлы",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Переименовать исходные RAW-файлы</b> \nИмена всех файлов приводятся к единому шаблону. \n\n<b>Обязательное требование к шаблону:</b>\n4-х значный индекс в имени файла должен быть заменён на 6-ти значный.\n</div>",
                  "silent_mode": true,
                  "icon_name": "COPY_RAW",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "br_source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Capture/{wf_photo_session}",
                      "enabled": true
                    },
                    "br_include": {
                      "value": [
                        "*.CR3"
                      ],
                      "enabled": true
                    },
                    "br_template": {
                      "value": "{wf_session_name}_%prefix%%index%%ext%",
                      "enabled": true
                    },
                    "br_prefix": {
                      "value": "27",
                      "enabled": true
                    },
                    "br_suffix": {
                      "value": "",
                      "enabled": true
                    },
                    "br_start_index": {
                      "value": 1,
                      "enabled": true
                    },
                    "br_index_digits": {
                      "value": "4",
                      "enabled": true
                    },
                    "br_on_conflict": {
                      "value": "rename",
                      "enabled": true
                    },
                    "br_sort_method": {
                      "value": "modified_time",
                      "enabled": true
                    },
                    "br_mode": {
                      "value": "dry_run",
                      "enabled": true
                    },
                    "br_recursive": {
                      "value": false,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/raw2jpeg",
                  "instance_id": "instance_8ec7572a47fc",
                  "name": "Конвертировать RAW в JPEG",
                  "description": "<div style=\"{theme.script_description}\">\nСкрипт, конвертирует исходные файлы изображений (RAW или PSD) в формат JPEG для последующего анализа другими скриптами.\n\nЕсли ваши изображения уже в формате JPG, то данный скрипт можно не запускать.\n</div>",
                  "silent_mode": true,
                  "icon_name": "CONVER_RAW",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Capture/{wf_photo_session}",
                      "enabled": true
                    },
                    "output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "a_r2j_image_type": {
                      "value": "raw",
                      "enabled": true
                    },
                    "a_r2j_preview_size": {
                      "value": "2048",
                      "enabled": true
                    },
                    "a_r2j_jpeg_quality": {
                      "value": 95,
                      "enabled": true
                    },
                    "recursive_read": {
                      "value": false,
                      "enabled": true
                    },
                    "keep_structure": {
                      "value": false,
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_5b535c4a01cb",
