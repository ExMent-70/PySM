                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_79d4b0f7d5e9",
                  "name": "Выбор съемки (портретная, студийная, школьная и т.д.)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "CAMERA",
