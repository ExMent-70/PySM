                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/raw2jpeg",
                  "instance_id": "instance_6c57562bfa75",
                  "name": "Конвертировать выбранные файлы из PSD в JPEG",
                  "description": "<div style=\"{theme.script_description}\">\nСкрипт, конвертирует исходные файлы изображений (RAW или PSD) в формат JPEG для последующего анализа другими скриптами.\n\nЕсли ваши изображения уже в формате JPG, то данный скрипт можно не запускать.\n</div>",
                  "silent_mode": true,
                  "icon_name": "CONVER_RAW",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Альбом/Фото/{wf_photo_session}",
                      "enabled": true
                    },
                    "output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "a_r2j_image_type": {
                      "value": "psd",
                      "enabled": true
                    },
                    "a_r2j_preview_size": {
                      "value": "2048",
                      "enabled": true
                    },
                    "a_r2j_jpeg_quality": {
                      "value": 95,
                      "enabled": true
                    },
                    "recursive_read": {
                      "value": true,
                      "enabled": true
                    },
                    "keep_structure": {
                      "value": false,
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_analysis",
                  "instance_id": "instance_2743e67f346b",
                  "name": "Обновить атрибуты лиц на выбранных фотографиях",
                  "description": "<div style=\" {theme.script_description}\"><b>ОБНОВЛЕНИЕ КООРДИНАТ</b>\nПосле выбора фотографий обязательно пересчитываем координаты ключевых точек лица.\nЭто необходимо для корректной работы механизма \"умного\" кадрирования и масштабирования в скрипте автоматической верстки.\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "a_af_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "a_af_output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_af_input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "a_af_mode": {
                      "value": "sync",
                      "enabled": true
                    },
                    "a_af_model_name": {
                      "value": "buffalo_l",
                      "enabled": true
                    },
                    "a_af_det_size": {
                      "value": 1280,
                      "enabled": true
                    },
                    "a_af_det_thresh": {
                      "value": "0.4",
                      "enabled": true
                    },
                    "a_af_tasks": {
                      "value": [
                        "gender",
                        "emotion",
                        "age",
                        "beauty",
                        "eyeblink"
                      ],
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_msg",
                  "instance_id": "instance_11cb2dc48910",
                  "name": "Запрос на повторное редактирование кластеров сюжетов",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "WARNING",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "dlg_msg_var": {
                      "value": "var_run_script",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Сообщение",
                      "enabled": true
                    },
                    "dlg_msg_message": {
                      "value": "Вы хотите уточнить кластеризацию фотографий по сюжетам (локациям)\nпосле отбора фотографий для альбома?\n\nНапример, если в альбоме несколько разных портретов (для обложки, \nвиньетки, персонального разворота и т.д.), вы можете создать\nдля них отдельные кластеры.\n\nДля более удобной работы включите в Редакторе кластеров\nфильтр \"Только фотографии, выбранные пользователями\".",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_if_else",
                  "instance_id": "instance_af28657b7501",
                  "name": "Повторная кластеризацию фото по сюжетам разрешена? (да/нет)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LOGIC_IF",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "if-variable-name": {
                      "value": "var_run_script",
                      "enabled": true
                    },
                    "if-operator": {
                      "value": "равно",
                      "enabled": true
                    },
                    "if-comparison-value": {
                      "value": "yes",
                      "enabled": true
                    },
                    "if-value-type": {
                      "value": "auto",
                      "enabled": true
                    },
                    "then-instance-id": {
                      "value": "instance_bf5ea537f4a8",
                      "enabled": true
                    },
                    "else-instance-id": {
                      "value": "instance_c17201aec6ce",
                      "enabled": true
                    },
                    "clear-variable": {
                      "value": true,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_editor",
                  "instance_id": "instance_bf5ea537f4a8",
                  "name": "Редактировать кластеры сюжетов для выбранных файлов",
                  "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ЛОКАЦИЙ (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_NATURE",
                  "icon_color": "#E67E22",
                  "command_line_args": {
                    "ce_working_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "ce_reference_dir": {
                      "value": "",
                      "enabled": true
                    },
                    "ce_student_list_file": {
                      "value": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list",
                      "enabled": true
                    },
                    "ce_export_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}",
                      "enabled": true
                    },
                    "ce_win_state_var_name": {
                      "value": "win_state.claster_editor",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "mode": {
                      "value": "location",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/photo_selection",
                  "instance_id": "instance_c17201aec6ce",
                  "name": "Формирование списка PSD-файлов для генерации альбома",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LIST",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "student_list_file": {
                      "value": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list",
                      "enabled": true
                    },
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Альбом/Фото/{wf_photo_session}",
                      "enabled": true
                    },
                    "dest_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
                      "enabled": true
                    },
                    "session_name": {
                      "value": "{wf_session_name}",
                      "enabled": true
                    },
                    "photo_session": {
                      "value": "{wf_photo_session}",
                      "enabled": true
                    },
                    "exclude_dirs": {
                      "value": [
                        "Masks"
                      ],
                      "enabled": false
                    },
                    "title": {
                      "value": "Этап 2. Формирование файла photo_assignments.json",
                      "enabled": true
                    },
                    "message": {
                      "value": "<h2>Этап 2. Формирование файла photo_assignments.json</h2>\n<p>Скрипт обработает экспортированные из Capture One файлы PSD/JPG, скопирует их в рабочие папки выпускного альбома (отсортировав по локациям) и создаст файл <b>photo_assignments.json</b>.</p>\n<p><b>Действие:</b> нажмите кнопку «Копировать и создать список».</p>\n<p>Фотографии, выбранные фотографом, должны быть экспортированы с префиксом <b>PH_</b>.</p>\n<p><b>Проверьте:</b> исходной папкой должна быть папка экспорта <b>Output/Альбом/Фото</b></p>",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/create_xmp",
                  "instance_id": "instance_87e14f606857",
                  "name": "Обновить XMP данные для выбранных фотографий",
                  "description": "<div style=\" {theme.script_description}\"><b>ОБНОВЛЕНИЕ КООРДИНАТ</b>\nПосле выбора фотографий обязательно обновляем все XMP данные содержащие координаты (bbox, kps и т.д.)\nЭто необходимо для корректной работы механизма \"умного\" кадрирования и масштабирования в скрипте автоматической верстки.\n </div>",
                  "silent_mode": true,
                  "icon_name": "FILE_XMP",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "image_dir": {
