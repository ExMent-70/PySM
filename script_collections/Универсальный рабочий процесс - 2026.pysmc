              "icon_color": "#9B59B6",
              "command_line_args": {
                "dlg_goto_script_id": {
                  "value": "instance_2654017d8dcb,instance_db8757f1c393,instance_159522451ddb,instance_4da40a7682a9,instance_d903650d6cec",
