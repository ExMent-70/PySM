                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_8146f53de948",
                  "name": "Копировать RAW-файлы  в папку сессии",
                  "description": "<div style=\" {theme.script_description}\">\nСкрипт копирует исходные RAW-файлы в папку Capture.\n</div>",
