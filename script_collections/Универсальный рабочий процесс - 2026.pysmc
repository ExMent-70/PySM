                    "dlg_msg_size_height": {
                      "value": "430",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/photo_selection",
                  "instance_id": "instance_e0c983997705",
                  "name": "Копирование выбранных RAW-файлов в папку SELECT",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "COPY_RAW",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "student_list_file": {
                      "value": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list",
                      "enabled": true
                    },
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Capture/{wf_photo_session}",
                      "enabled": true
                    },
                    "dest_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Selects/{wf_photo_session}",
                      "enabled": true
                    },
                    "session_name": {
                      "value": "{wf_session_name}",
                      "enabled": true
                    },
                    "photo_session": {
                      "value": "{wf_photo_session}",
                      "enabled": true
                    },
                    "exclude_dirs": {
                      "value": [
                        "Masks"
                      ],
                      "enabled": true
                    },
                    "title": {
                      "value": "Этап 1. Подготовка выбранных файлов для обработки в Capture One",
                      "enabled": true
                    },
                    "message": {
                      "value": "<h2>Этап 1. Подготовка выбранных файлов для обработки в Capture One</h2>\n<p>На этом этапе выбранные клиентами RAW-файлы, XMP и настройки Capture One копируются из папки <b>Capture</b> в папку <b>Selects</b>.</p>\n<p><b>Действие:</b> нажмите кнопку «Копировать выбранные файлы».</p>\n<p>После копирования откройте Capture One, выполните проявку и экспорт выбранных фотографий.</p>\n<p><b>Важно:</b> файл photo_assignments.json на этом этапе создавать не нужно.</p>",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_0b4c88579d8c",
                  "name": "Запуск Capture One. Обработка и экспорт выбранных файлов в PSD",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "APP_C1",
                  "icon_color": "#E67E22",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_4744151cd80e,instance_ad14513b5b7f",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_ac996149d42f",
                  "name": "Обновить информацию в JSON и XMP для выбранных файлов",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "COPY_RAW",
                  "icon_color": "#27AE60",
