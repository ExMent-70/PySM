        {
          "type": "set_folder",
          "id": "foldernode_3ce71ff58ab7",
          "name": "JPG",
          "description": null,
          "children": [
            {
              "type": "script_set",
              "id": "setnode_708c7f947f22",
              "name": "Этап J1. Подготовка исходных JPG-файлов для AI-анализа",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_5e49df080f51",
                  "name": "Выбор съемки (портретная, студийная, школьная и т.д.)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "CAMERA",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_15acb76a98e2",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_d3d75b26b404",
                  "name": "Выбрать папку с исходными файлами JPG",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "FOLDER_OPEN",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_3e1d9138efe0",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_261ac90212e1",
                  "name": "Копировать JPG-файлы в папку сессии",
                  "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                  "silent_mode": true,
                  "icon_name": "COPY_JPG",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_source_file_path}",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "copy",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*.jpg",
                        "*.jpeg"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/batch_rename",
                  "instance_id": "instance_6505b2d7b026",
                  "name": "Переименовать исходные JPG-файлы",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Переименовать исходные JPG-файлы</b> \nИмена всех файлов приводятся к единому шаблону. \n\n<b>Обязательное требование к шаблону:</b>\n4-х значный индекс в имени файла должен быть заменён на 6-ти значный.\n</div>",
                  "silent_mode": true,
                  "icon_name": "COPY_RAW",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "br_source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "br_include": {
                      "value": [
                        "*.JPG"
                      ],
                      "enabled": true
                    },
                    "br_template": {
                      "value": "{wf_session_name}_%prefix%%index%%ext%",
                      "enabled": true
                    },
                    "br_prefix": {
                      "value": "77",
                      "enabled": true
                    },
                    "br_suffix": {
                      "value": "",
                      "enabled": true
                    },
                    "br_start_index": {
                      "value": 1,
                      "enabled": true
                    },
                    "br_index_digits": {
                      "value": "4",
                      "enabled": true
                    },
                    "br_on_conflict": {
                      "value": "rename",
                      "enabled": true
                    },
                    "br_sort_method": {
                      "value": "modified_time",
                      "enabled": true
                    },
                    "br_mode": {
                      "value": "dry_run",
                      "enabled": true
                    },
                    "br_recursive": {
                      "value": false,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_be3cc94ff67c",
                  "name": "Создать маски фона",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "CAMERA",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_2c4d762ab2ec",
                      "enabled": true
                    }
                  }
                }
              ]
            },
            {
              "type": "script_set",
              "id": "setnode_3f0712c60287",
              "name": "Этап J2. Определение лиц на фотографиях",
              "description": null,
              "script_entries": [
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_analysis",
                  "instance_id": "instance_ebcbcf9cb8b1",
                  "name": "Найти все лица на изображениях. Вычислить эмбединги",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Основной скрипт в конвейере анализа изображений</b> \nСкрипт анализирует изображения в формате JPG, распознает на них лица людей и переводит их в векторный формат (вычисляет эмбединги). \n\nРезультаты AI-анализа сохраняются в оптимизированном формате в <b>JSON и NPY-файлы:</b> основные метаданные и тяжелая геометрия (ландмарки) разделены по разным файлам для ускорения работы.\n\nСкрипт работает только с файлами JPG, поэтому RAW и PSD файлы необходимо предварительно конвертировать.\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT",
                  "icon_color": null,
                  "command_line_args": {
                    "a_af_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "a_af_output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_af_input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "a_af_mode": {
                      "value": "create",
                      "enabled": true
                    },
                    "a_af_model_name": {
                      "value": "buffalo_l",
                      "enabled": true
                    },
                    "a_af_det_size": {
                      "value": 1280,
                      "enabled": true
                    },
                    "a_af_det_thresh": {
                      "value": "0.4",
                      "enabled": true
                    },
                    "a_af_tasks": {
                      "value": [
                        "gender",
                        "emotion",
                        "age",
                        "beauty",
                        "eyeblink"
                      ],
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_keypoints",
                  "instance_id": "instance_a97adb8a12ab",
                  "name": "Дополнительный анализ лиц",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Необязательный скрипт в конвейере анализа изображений</b> \nСкрипт, на основании вычисленных ключевых точек <i>landmark_2d_106</i> и <i>landmark_3d_68</i>, анализирует атрибуты лица/головы: состояние глаз (открыты/закрыты) и рта (открыт/закрыт), поворот и наклон (вправо/влево/вверх/вниз).\n\nПолученные данные сохраняются в файл <b>info_face.json</b>.\n\nЕсли эти данные не нужны, то скрипт можно удалить из рабочеого процесса\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT_EDIT",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "a_ak_data_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_ak_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_dcb579d431d1",
                  "name": "Инициализация флагов кластеризации",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "VAR_SET",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_a90bb12502b3,instance_8d86e998a3a1,instance_c56859ed85e9,instance_d1fb9cefcef6,instance_ef9f28a2cd77",
                      "enabled": true
                    }
                  }
                }
              ]
            },
