            {
              "type": "script_set",
              "id": "setnode_dea67579a40a",
              "name": "ОП: Настройка ЛОКАЛЬНЫХ переменных",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_html",
                  "instance_id": "instance_2654017d8dcb",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "html_content": {
                      "value": "<b>НАСТРОЙКА ЛОКАЛЬНОГО ОКРУЖЕНИЯ</b>\n<i>(обязательно выполняется для каждого учебного класс/группы)</i><br>\nДля корректной работы скриптов необходимо внести следующую информацию:\n\n<b>WF_SCHOOL_INFO</b> - подробная информация о проекте: город, полное и сокращенное название школы, параллель, класс и т.д. \nИнформация используется при автоматической верстки альбомов.\n<i>(в список можно добавить любое количество дополнительных полей)</i>\n\n<b>СПИСОК КЛАССА</b> -  подробная информация о всех участниках съемки (ФИО, вид и стоимость заказываемой фотопродукции, цитата и т.д.).\nИнформация сохраняется в текстовый файл <i>[wf_session_name].list</i> (например, <b>{wf_session_name}.list</b>).\n<i>(в список можно добавить любое количество дополнительных полей)</i>\n\nИнформацию о проекте и классе можно РЕДАКТИРОВАТЬ в любое время!",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_output": {
                      "value": "console_dialog",
                      "enabled": true
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": "0",
                      "enabled": true
                    },
                    "html_padding": {
                      "value": 10,
                      "enabled": true
                    },
                    "html_style": {
                      "value": "script_description",
                      "enabled": true
                    },
                    "dlg_msg_var": {
                      "value": "var_setup.local",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_text_ok": {
                      "value": "Продолжить настройку локальных переменных",
                      "enabled": true
                    },
                    "dlg_msg_text_no": {
                      "value": "Завершить",
                      "enabled": true
                    },
                    "dlg_msg_text_cancel": {
                      "value": "Отменить",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Информационное сообщение",
                      "enabled": true
                    },
                    "dlg_msg_size_width": {
                      "value": "640",
                      "enabled": true
                    },
                    "dlg_msg_size_height": {
                      "value": "390",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/session_create",
                  "instance_id": "instance_db8757f1c393",
                  "name": "Создать структуру рабочих папок",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "COPY_C1",
                  "icon_color": null,
                  "command_line_args": {
                    "wf_session_name": {
                      "value": "{wf_session_name}",
                      "enabled": true
                    },
                    "wf_raw_path": {
                      "value": "{wf_source_file_path}",
                      "enabled": true
                    },
                    "wf_session_path": {
                      "value": "{wf_session_path}",
                      "enabled": true
                    },
                    "wf_psd_path": {
