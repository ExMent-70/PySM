                {
                  "id": "root_790d968b/Photoshop/ps_photoshop_launch",
                  "instance_id": "instance_345d80cc6e06",
                  "name": "Запустить Фотошоп",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "INSTANCE_ITEM",
                  "icon_color": null,
                  "command_line_args": {
                    "ps_app_dir": {
                      "value": null,
                      "enabled": false
