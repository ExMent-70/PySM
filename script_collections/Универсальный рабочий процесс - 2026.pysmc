                      "enabled": true
                    },
                    "wf_overwrite_album": {
                      "value": false,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/list_create",
                  "instance_id": "instance_159522451ddb",
                  "name": "Редактировать список класса/группы",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LIST",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "wf_dest_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}",
                      "enabled": true
                    },
                    "wf_autosave_formats": {
                      "value": [
                        "html",
                        "csv"
                      ],
                      "enabled": true
                    },
                    "wf_default_info_fields": {
                      "value": [
                        "Цитата"
                      ],
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_json_editor",
                  "instance_id": "instance_4da40a7682a9",
                  "name": "Название и номер школы, класс, параллель (для альбома)",
                  "description": "<div style=\" {theme.script_description}\"><b>Структурированная информация об учебном заведении, классе/группе</b>\nДанные используются при автоматической вёрстке разворотов альбома.\n\nНапример, если в шаблоне альбома будет определён текстовый плейсхолдер <i>{{Название школы}}</i>, то вместо него будет подставлено соответствующее значение <b>\"{wf_school_info.Название школы}\"</b>.\n\nВ таблицу можно добавить любое количество дополнительных полей.</div>",
                  "silent_mode": true,
                  "icon_name": "HOME",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "var_name": {
                      "value": "wf_school_info",
                      "enabled": true
                    },
                    "title": {
                      "value": "Карточка класса",
                      "enabled": true
                    },
                    "html_content": {
                      "value": "<b>ЗАПОЛНИТЕ КАРТОЧКУ КЛАССА</b>\nДанные будут использованы при автоматической вёрстке разворотов альбома.\n\nНапример, если в шаблоне альбома будет определён текстовый плейсхолдер <i>{{Название школы}}</i>, то вместо него будет подставлено соответствующее значение <b>\"{wf_school_info.Название школы}\"</b>.\n\nВ таблицу можно добавить любое количество дополнительных полей.",
                      "enabled": true
                    },
                    "html_output": {
                      "value": "dialog",
                      "enabled": true
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": 0,
                      "enabled": true
                    },
                    "html_padding": {
                      "value": 10,
                      "enabled": true
                    },
                    "html_style": {
                      "value": "script_description",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/Tools/session_report",
                  "instance_id": "instance_d903650d6cec",
                  "name": "Информационная панель",
                  "description": "<div style=\" {theme.script_description}\">Подробная информация о всех этапах работы над текущим проектом, включая активные ссылки на ресурсы проекта (файлы и папки)</div>",
                  "silent_mode": true,
                  "icon_name": "REPORT",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "template": {
                      "value": "workflow",
                      "enabled": true
                    },
                    "scope": {
                      "value": "full",
                      "enabled": true
                    },
                    "icon_size_tree": {
                      "value": 24,
                      "enabled": true
                    },
                    "icon_size_dashboard": {
                      "value": "40",
                      "enabled": true
                    }
                  }
                }
              ]
            },
            {
              "type": "script_set",
              "id": "setnode_8953d37a9a2c",
              "name": "ОП: Предварительно настроенные скрипты",
              "description": null,
              "script_entries": [
                {
                  "id": "root_790d968b/Workflow2/Tools/project_crm",
                  "instance_id": "instance_f5a29bc72dfe",
                  "name": "Управление фотопроектами",
                  "description": "<div style=\" {theme.script_description}\">Локальная система управления фотопроектами \n\nСкрипт автоматически собирает информацию о каждом рабочем проекте текущего сезона и позволяет дополнять её контактами заказчиков, этапами выполнения проекта, финансовыми операциями, съёмками и историей сообщений.\n\nПроектом считается каждая непосредственная дочерняя папка внутри <b>{wf_psd_path}</b>. \n</div>",
