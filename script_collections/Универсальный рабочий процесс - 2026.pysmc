                    },
                    "landmark_enable": {
                      "value": false,
                      "enabled": true
                    },
                    "scan_folder_mode": {
                      "value": true,
                      "enabled": true
                    },
                    "xmp_subfolder": {
                      "value": true,
                      "enabled": true
                    }
                  }
                },
                {
