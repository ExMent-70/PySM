              ]
            },
            {
              "type": "script_set",
              "id": "setnode_4961250c824d",
              "name": "Этап R4. Отбор фотографий и подготовка данных для верстки альбома",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_html",
                  "instance_id": "instance_74efc0dc6f18",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "html_content": {
                      "value": "<b>ОТБОР ФОТОГРАФИЙ ДЛЯ АЛЬБОМА</b>\n<i>(выполняется для каждой фотосесси класса/группы)</i><br>\nВ данном блоке запускается несколько экземпляров одного и того же скрипа <b>Отбор фотографий</b> с разными настройками.\n\n1. Первый экземпляр скрипта собирает номера фотографий выбранных пользователем/фотографом из различных источников (физически скпированные исходные файлы, неструктурированные текстовые и csv-файлы, ручной ввод номеров) и формирует единый структурированный файл с номерами всех выбранных фотографий: <i>{wf_session_name}\\Output\\Analysis_{wf_photo_session}\\photo_selection.json</i>\n\nПосле этого все отобранные RAW-файлы копируются в папку <i>{wf_session_name}\\Select</i> для дальнейшей обработки в <b>Capture One</b>.\n\n2. Второй экземпля скрипта создаёт список уже обработанных и экспортированных из <b>Capture One</b> файлов JPG/PSD, сохраняет его в файл <i>{wf_session_name}\\Output\\Analysis_{wf_photo_session}\\photo_assignments.json</i> и копирует JPG/PSD файлы в папку <i>{wf_psd_path}\\{wf_session_name}\\Альбом\\Фото\\{wf_photo_session}</i>\n\nИменно этот файл в дальнейшем будет использован для автоматической верстки альбомов.\n",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_output": {
                      "value": "console_dialog",
                      "enabled": true
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": "0",
                      "enabled": true
                    },
                    "html_padding": {
                      "value": "10",
                      "enabled": true
                    },
                    "html_style": {
                      "value": "script_description",
                      "enabled": true
                    },
                    "dlg_msg_var": {
                      "value": "var_setup.claster",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_text_ok": {
                      "value": "Выполнить отбор фотографий",
                      "enabled": true
                    },
                    "dlg_msg_text_no": {
                      "value": "Завершить",
                      "enabled": true
                    },
                    "dlg_msg_text_cancel": {
                      "value": "Отменить",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Информационное сообщение",
                      "enabled": true
                    },
                    "dlg_msg_size_width": {
                      "value": "700",
                      "enabled": true
