            {
              "type": "script_set",
              "id": "setnode_801cfcb3b977",
              "name": "Этап J4. Отбор фотографий и подготовка данных для верстки альбома",
              "description": null,
              "script_entries": [
                {
                  "id": "root_790d968b/Workflow2/Tools/photo_selection",
                  "instance_id": "instance_c96bbfe72cdc",
                  "name": "Отбор фотографий для альбома",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "SELECT_FILES",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "student_list_file": {
                      "value": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list",
                      "enabled": true
                    },
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "dest_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
                      "enabled": true
                    },
                    "session_name": {
                      "value": "{wf_session_name}",
                      "enabled": true
                    },
                    "photo_session": {
                      "value": "{wf_photo_session}",
                      "enabled": true
                    },
                    "exclude_dirs": {
                      "value": [
                        "Masks"
                      ],
                      "enabled": true
                    },
                    "title": {
                      "value": "Отбор фотографий для альбома",
                      "enabled": true
                    },
                    "message": {
                      "value": "<h2>РАБОТА С JPG-ФАЙЛАМИ</h2>\n<p>Скрипт найдёт выбранные фотографии, скопирует их в папки соответствующих локаций и создаст файл <b>photo_assignments.json</b>.</p>\n<p><b>Действие:</b> нажмите кнопку «Копировать и создать список».</p>",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/GUI/gui_dialog_msg",
                  "instance_id": "instance_e83db873a8d1",
                  "name": "Запрос на повторное редактирование кластеров сюжетов",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "WARNING",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_msg_var": {
                      "value": "var_run_script",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Сообщение",
                      "enabled": true
                    },
                    "dlg_msg_message": {
                      "value": "Вы хотите уточнить кластеризацию фотографий по сюжетам (локациям)\nпосле отбора фотографий для альбома?\n\nНапример, если в альбоме несколько разных портретов (для обложки, \nвиньетки, персонального разворота и т.д.), вы можете создать\nдля них отдельные кластеры.\n\nДля более удобной работы включите в Редакторе кластеров\nфильтр \"Только фотографии, выбранные пользователями\".",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_if_else",
                  "instance_id": "instance_18e5236125cf",
                  "name": "Повторная кластеризацию фото по сюжетам разрешена? (да/нет)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LOGIC_IF",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "if-variable-name": {
                      "value": "var_run_script",
                      "enabled": true
                    },
                    "if-operator": {
                      "value": "равно",
                      "enabled": true
                    },
                    "if-comparison-value": {
                      "value": "yes",
                      "enabled": true
                    },
                    "if-value-type": {
                      "value": "auto",
                      "enabled": true
                    },
                    "then-instance-id": {
                      "value": "instance_0bd19f660805",
                      "enabled": true
                    },
                    "else-instance-id": {
                      "value": "instance_e891495c2385",
                      "enabled": true
                    },
                    "clear-variable": {
                      "value": true,
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/cluster_editor",
                  "instance_id": "instance_0bd19f660805",
                  "name": "Редактировать кластеры сюжетов для выбранных файлов",
                  "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ЛОКАЦИЙ (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_NATURE",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "ce_working_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "ce_reference_dir": {
                      "value": "",
                      "enabled": true
                    },
                    "ce_student_list_file": {
                      "value": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list",
                      "enabled": true
                    },
                    "ce_export_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}",
                      "enabled": true
                    },
                    "ce_win_state_var_name": {
                      "value": "win_state.claster_editor",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "mode": {
                      "value": "location",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_b55beb286ee4",
                  "name": "Веруться к отбору фотографий для альбома",
                  "description": null,
                  "silent_mode": false,
                  "icon_name": "EXIT",
                  "icon_color": "#27AE60",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_c96bbfe72cdc",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/create_xmp",
                  "instance_id": "instance_e891495c2385",
                  "name": "Обновить XMP данные для выбранных фотографий",
                  "description": "<div style=\" {theme.script_description}\"><b>СОЗДАНИЕ/ОБНОВЛЕНИЕ XMP-ФАЙЛОВ</b>\nПосле отбора  фотографий для альбома обязательно создаём/обновляем XMP-файлы (поля содержащие координаты bbox, kps и т.д.)\nЭто необходимо для корректной работы механизма \"умного\" кадрирования и масштабирования в скрипте автоматической верстки.\n </div>",
                  "silent_mode": true,
                  "icon_name": "FILE_XMP",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "analysis_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "image_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
                      "enabled": true
                    },
                    "student_list_file": {
                      "value": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "landmark_enable": {
                      "value": false,
                      "enabled": true
                    },
                    "scan_folder_mode": {
                      "value": true,
                      "enabled": true
                    },
                    "xmp_subfolder": {
                      "value": true,
                      "enabled": true
                    }
                  }
                }
              ]
            },
