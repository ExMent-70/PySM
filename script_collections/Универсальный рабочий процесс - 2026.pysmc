                  }
                }
              ]
            },
            {
              "type": "script_set",
              "id": "setnode_de90c35483d2",
              "name": "Этап R2. Определение лиц на фотографиях",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_html",
                  "instance_id": "instance_b3a9f0f716c5",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "html_content": {
                      "value": "<b>ОПРЕДЕЛЕНИЕ ЛИЦ НА ФОТОГРАФИЯ</b>\n<i>(выполняется для каждой фотосесси класса/группы)</i><br>\nСкрипты входящие в эту группу составляют основу всего рабочего процесса. Именно эти скрипты:\n\n<b>1. Выполняют задачу поиска лиц на фотография.</b>\n\n<b>2. Вычисляют эмбединги - цифровое представление лиц.</b>\n\n<b>3. Определяют атрибуты найденных лиц: пол, состояние рта и глаз, положение головы</b>\n\nРезультаты работы скриптов сохраняются в файлы:\n<i>- {wf_session_path}\\{wf_session_name}\\Output\\Analysis_{wf_photo_session}\\info_faces.json</i>\n<i>- {wf_session_path}\\{wf_session_name}\\Output\\Analysis_{wf_photo_session}\\info_faces_landmarks.json</i>\n",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_output": {
                      "value": "console_dialog",
                      "enabled": true
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": "0",
                      "enabled": true
                    },
                    "html_padding": {
                      "value": "10",
                      "enabled": true
                    },
                    "html_style": {
                      "value": "script_description",
                      "enabled": true
                    },
                    "dlg_msg_var": {
                      "value": "var_setup.face_find",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_text_ok": {
                      "value": "Определить лица на фотографиях",
                      "enabled": true
                    },
                    "dlg_msg_text_no": {
                      "value": "Завершить",
                      "enabled": true
                    },
                    "dlg_msg_text_cancel": {
                      "value": "Отменить",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Информационное сообщение",
                      "enabled": true
                    },
                    "dlg_msg_size_width": {
                      "value": "570",
                      "enabled": true
                    },
                    "dlg_msg_size_height": {
                      "value": "380",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_analysis",
                  "instance_id": "instance_2f1930df5a8e",
                  "name": "Найти все лица на изображениях. Вычислить эмбединги",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Основной скрипт в конвейере анализа изображений</b> \nСкрипт анализирует изображения в формате JPG, распознает на них лица людей и переводит их в векторный формат (вычисляет эмбединги). \n\nРезультаты AI-анализа сохраняются в оптимизированном формате в <b>JSON и NPY-файлы:</b> основные метаданные и тяжелая геометрия (ландмарки) разделены по разным файлам для ускорения работы.\n\nСкрипт работает только с файлами JPG, поэтому RAW и PSD файлы необходимо предварительно конвертировать.\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT",
                  "icon_color": null,
                  "command_line_args": {
                    "a_af_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    },
                    "a_af_output_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_af_input_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    },
                    "a_af_mode": {
                      "value": "create",
                      "enabled": true
                    },
                    "a_af_model_name": {
                      "value": "buffalo_l",
                      "enabled": true
                    },
                    "a_af_det_size": {
                      "value": 1280,
                      "enabled": true
                    },
                    "a_af_det_thresh": {
                      "value": "0.4",
                      "enabled": true
                    },
                    "a_af_tasks": {
                      "value": [
                        "gender",
                        "emotion",
                        "age",
                        "beauty",
                        "eyeblink"
                      ],
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow2/FaceAnalysis/face_keypoints",
                  "instance_id": "instance_3ef867502e0b",
                  "name": "Дополнительный анализ лиц",
                  "description": "<div style=\" {theme.script_description}\">\n<b>Необязательный скрипт в конвейере анализа изображений</b> \nСкрипт, на основании вычисленных ключевых точек <i>landmark_2d_106</i> и <i>landmark_3d_68</i>, анализирует атрибуты лица/головы: состояние глаз (открыты/закрыты) и рта (открыт/закрыт), поворот и наклон (вправо/влево/вверх/вниз).\n\nПолученные данные сохраняются в файл <b>info_face.json</b>.\n\nЕсли эти данные не нужны, то скрипт можно удалить из рабочеого процесса\n</div>",
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT_EDIT",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "a_ak_data_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}",
                      "enabled": true
                    },
                    "a_ak_config_file": {
                      "value": "config.toml",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_77f61598df06",
                  "name": "Инициализация флагов кластеризации",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "VAR_SET",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_a90bb12502b3,instance_8d86e998a3a1,instance_c56859ed85e9,instance_d1fb9cefcef6,instance_ef9f28a2cd77",
                      "enabled": true
                    }
                  }
                }
              ]
            },
            {
              "type": "script_set",
              "id": "setnode_fb20bf4304fb",
              "name": "Этап R3. Кластеризация фотографий",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_html",
                  "instance_id": "instance_e10e5715182a",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "html_content": {
                      "value": "<b>КЛАСТЕРИЗАЦИЯ ФОТОГРАФИЙ</b>\n<i>(выполняется для каждой фотосесси класса/группы)</i><br>\nСкрипты этого набора выполняют класстеризация (группировку) фотографий по нескольким признакам:\n\n<b>1. Техническая кластериазация</b>\nУдаляет \"мусорные\" лица на фотографиях - плакаты и фотографии на стенах, бюсты и т.д.\n\n<b>2. Группировка портретных фотографий</b>\nСобирает портреты каждого человека в отдельный кластер/группу. Кластер получает имя определяемое фамилией данного человека\n\n<b>3. Группировка фотографий по локациям/сюжетам</b>\nСобирает все однотипные фотографии в группы. Каждой группе присваивается определенное имя.\n\n<b>4. Идентификация лиц на групповых фотографиях</b>\nФормируется для каждого человека пакет групповых фотографий на которых он присутствует.\n\nДополнительно, скрипты этой группы:\n<b>Экспортируют фотографии в формат JPG с водяными знаками</b>\nФотографии сгруппированы при признакам кластеризации\n\n<b>Создают для каждого исходного файла связанный XMP-файл</b>\nXMP-файл является связующим звеном между этапом AI-анализа и программами каталогизации (Capture One, ACR, Lightroom). \n\n<b>Создают наглядный HTML-отчет с результатами кластеризации</b>\nФайл <i>{wf_session_path}\\{wf_session_name}\\Output\\Analysis_{wf_photo_session}\\face_clustering_report.html</i>\n",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_output": {
                      "value": "console_dialog",
                      "enabled": true
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": "0",
                      "enabled": true
                    },
                    "html_padding": {
                      "value": "10",
                      "enabled": true
                    },
                    "html_style": {
                      "value": "script_description",
                      "enabled": true
                    },
                    "dlg_msg_var": {
                      "value": "var_setup.claster",
                      "enabled": true
                    },
                    "dlg_msg_type": {
                      "value": "yes_no",
                      "enabled": true
                    },
                    "dlg_msg_text_ok": {
                      "value": "Выполнить кластеризацию фотографий",
                      "enabled": true
                    },
                    "dlg_msg_text_no": {
                      "value": "Завершить",
                      "enabled": true
                    },
                    "dlg_msg_text_cancel": {
                      "value": "Отменить",
                      "enabled": true
                    },
                    "dlg_msg_title": {
                      "value": "Информационное сообщение",
                      "enabled": true
                    },
                    "dlg_msg_size_width": {
                      "value": "700",
                      "enabled": true
                    },
                    "dlg_msg_size_height": {
                      "value": "580",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/py_goto",
                  "instance_id": "instance_dadfec0426a9",
                  "name": "Этап 3.1. Техническая группировка фотографий",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "PHOTO_PORTRAIT",
                  "icon_color": "#E67E22",
                  "command_line_args": {
                    "dlg_goto_script_id": {
                      "value": "instance_c3087c67e4d5,instance_8d9cb8612154,instance_787f22a493a7,instance_28c4c9692a63,instance_706c4c67dc94",
