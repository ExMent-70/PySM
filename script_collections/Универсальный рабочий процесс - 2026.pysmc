                  }
                },
                {
                  "id": "root_790d968b/Photoshop/ps_action_batch_set_select",
                  "instance_id": "instance_65a8c2e70551",
                  "name": "Пакетный  запуск универсального экшена PySM_RETUCHE_RUN",
                  "description": "<div style=\" {theme.script_description}\">\n<b>ЗАПУСК ЭКШЕНА PySM_RETUCHE_RUN</b>\n\nСкрипт автоматический запускает обработку всех файлов в указанной папке с помощью экшена  <b>PySM_RETUCHE_RUN</b> из набора <b>PySM_Actions</b>\n</div>",
                  "silent_mode": false,
                  "icon_name": "APP_PHOTOSHOP",
                  "icon_color": null,
                  "command_line_args": {
                    "ps_mode": {
                      "value": "selected_file_folder",
                      "enabled": true
                    },
                    "ps_file_path": {
                      "value": "{wf_psd_path}/{wf_session_name}/Альбом/Фото/{wf_photo_session}/11.psd",
                      "enabled": true
                    },
                    "ps_recursive": {
                      "value": true,
                      "enabled": true
                    },
                    "ps_action_set": {
                      "value": "PySM_Actions",
                      "enabled": true
                    },
                    "ps_action_name": {
                      "value": "PySM_RETUCHE_RUN",
                      "enabled": true
                    },
                    "ps_need_save": {
                      "value": true,
                      "enabled": true
                    },
                    "ps_wait_after_action": {
                      "value": "2",
                      "enabled": true
                    }
                  }
                },
                {
                  "id": "root_790d968b/Photoshop/ps_document_close",
                  "instance_id": "instance_ee765768bf29",
                  "name": "Закрыть файл-пресет",
                  "description": null,
                  "silent_mode": true,
