            {
              "type": "script_set",
              "id": "setnode_feb7095548a1",
              "name": "RAW. Отбор файлов для альбома",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/SYSTEM/py_path_if_else",
                  "instance_id": "instance_0a33616cddfd",
                  "name": "Проверить наличие файлов PSD экспортированных из Capture One",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "LOGIC_IF",
                  "icon_color": "#9B59B6",
                  "command_line_args": {
                    "checked-path": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/Альбом/Фото/{wf_photo_session}",
                      "enabled": true
                    },
                    "condition": {
                      "value": "папка содержит файлы",
                      "enabled": true
                    },
                    "patterns": {
                      "value": [
                        "*.psd"
                      ],
                      "enabled": true
                    },
                    "recursive": {
                      "value": true,
                      "enabled": true
                    },
                    "then-instance-id": {
                      "value": "instance_6c57562bfa75",
                      "enabled": true
                    },
                    "else-instance-id": {
