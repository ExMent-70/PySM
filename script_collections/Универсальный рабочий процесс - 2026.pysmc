        {
          "type": "set_folder",
          "id": "foldernode_5bcaa23bab53",
          "name": "Старые наборы скриптов",
          "description": null,
          "children": [
            {
              "type": "script_set",
              "id": "setnode_a71102a83540",
              "name": "Настройка ЛОКАЛЬНЫХ переменных (один раз для каждого класса(группы)",
              "description": null,
              "script_entries": [
                {
                  "id": "root_7617c03c/GUI/gui_dialog_html",
                  "instance_id": "instance_cb6ba43b151d",
                  "name": "Информационное сообщение",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "INFO",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "html_content": {
                      "value": "<b>НАСТРОЙКА ЛОКАЛЬНОГО ОКРУЖЕНИЯ</b>\n<i>(обязательно выполняется для каждого учебного класс/группы)</i><br>\nДля корректной работы скриптов необходимо внести следующую информацию:\n<b>WF_SESSION_NAME</b> - уникальное (неповторяющееся) название класса/группы. \nИспользуется при создании папки, в которой хранятся все связанные с текущим проектом файлы.\n\n<b>WF_SCHOOL_INFO</b> - подробная информация о проекте: город, полное и сокращенное название школы, параллель, класс и т.д. \nИнформация используется при автоматической верстки альбомов.\n<i>(в список можно добавить любое количество дополнительных полей)</i>\n\n<b>СПИСОК КЛАССА</b> -  подробная информация о всех участниках съемки (ФИО, вид и стоимость заказываемой фотопродукции, цитата и т.д.).\nИнформация сохраняется в текстовый файл <i>[wf_session_name].list</i> (например, <b>{wf_session_name}.list</b>).\n<i>(в список можно добавить любое количество дополнительных полей)</i>\n\nИнформацию о проекте и классе можно РЕДАКТИРОВАТЬ в любое время!",
                      "enabled": true
                    },
                    "html_file": {
                      "value": null,
                      "enabled": false
                    },
                    "html_output": {
                      "value": "console_dialog",
                      "enabled": true
                    },
                    "html_align": {
                      "value": "left",
                      "enabled": true
                    },
                    "html_margin": {
                      "value": "0",
                      "enabled": true
                    },
                    "html_padding": {
                      "value": 10,
                      "enabled": true
                    },
                    "html_style": {
