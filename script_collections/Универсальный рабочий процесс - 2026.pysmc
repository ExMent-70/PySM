                {
                  "id": "root_7617c03c/GUI/gui_json_editor",
                  "instance_id": "instance_748845cf5dbe",
                  "name": "Название и номер школы, класс, параллель (для альбома)",
                  "description": null,
                  "silent_mode": true,
                  "icon_name": "VAR_SET",
                  "icon_color": "#3498DB",
                  "command_line_args": {
                    "var_name": {
                      "value": "wf_school_info",
                      "enabled": true
