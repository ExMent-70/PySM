                {
                  "type": "script_set",
                  "id": "setnode_a975c198e3ea",
                  "name": "Этап 6. Завершение работы. Один раз для каждого класса(группы)",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_790d968b/Photoshop/ps_photoshop_launch",
                      "instance_id": "instance_1604ac8cf1f2",
                      "name": "Фотошоп - Запустить",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
