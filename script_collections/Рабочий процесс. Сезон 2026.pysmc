                        "html"
                      ],
                      "enabled": true
                    }
                  }
                }
              ]
            },
            {
              "type": "set_folder",
              "id": "foldernode_5a501f2575ca",
              "name": "Этапы",
              "description": null,
              "children": [
                {
                  "type": "script_set",
                  "id": "setnode_0c76bfcfd542",
                  "name": "Этап 1. Подготовка  RAW-файлов. Для каждой фотосессии",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_choice",
                      "instance_id": "instance_fd471fea6282",
                      "name": "Выбор съемки (портретная, студийная, школьная и т.д.)",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_choice_var": {
                          "value": "wf_photo_session",
                          "enabled": true
                        },
                        "dlg_choice_title": {
                          "value": "Выбор съемки",
                          "enabled": true
                        },
                        "dlg_choice_message": {
                          "value": "Если договором предусмотрено несколько съемок\n(например: портретная, студийная, школьная и т.д.),\nукажите название текущей съемки.\n\nВыберите название съемки в выпадающем списке:\n",
                          "enabled": true
                        },
                        "dlg_choice_list": {
                          "value": [
                            "PORTRAIT",
                            "SCHOOL",
                            "SEPTEMBER1",
                            "STREET",
                            "STUDIO"
                          ],
                          "enabled": true
                        },
                        "dlg_choice_dvalue": {
                          "value": "",
                          "enabled": false
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_msg",
                      "instance_id": "instance_289529716c9a",
                      "name": "СООБЩЕНИЕ: Вставить карту памяти в компьютер",
                      "description": null,
                      "silent_mode": true,
                      "command_line_args": {
                        "dlg_msg_var": {
                          "value": "var_user_choice",
                          "enabled": true
                        },
                        "dlg_msg_type": {
                          "value": "yes_no",
                          "enabled": true
                        },
                        "dlg_msg_title": {
                          "value": "Подтверждение",
                          "enabled": true
                        },
                        "dlg_msg_message": {
                          "value": "Не забудьте вставить карту памяти с RAW файлами в картридер вашего компьютера.\n\nОперация копирования займет некоторое время.\nВы готовы продолжить?",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_open",
                      "instance_id": "instance_97a5109459be",
                      "name": "ДИАЛОГ: Выбрать карту памяти с исходными RAW-файлами",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_open_var": {
                          "value": "wf_raw_path",
                          "enabled": true
                        },
                        "dlg_open_type": {
                          "value": "directory",
                          "enabled": true
                        },
                        "dlg_open_title": {
                          "value": "Выбрать карту памяти с исходными RAW-файлами",
                          "enabled": true
                        },
                        "dlg_open_filter": {
                          "value": "Все файлы (*.*)",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/wf_list_create",
                      "instance_id": "instance_5430738be9bb",
                      "name": "Добавить порядковый номер съемки в список класса/группы",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "wf_dest_dir": {
                          "value": "{wf_psd_path}/{wf_session_name}",
                          "enabled": true
                        },
                        "wf_output_txt_file": {
                          "value": "{wf_session_path}/{wf_session_name}/{wf_photo_session}_{wf_children_file_name}",
                          "enabled": true
                        },
                        "wf_autosave_formats": {
                          "value": [
                            "html",
                            "txt"
                          ],
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/dir_operation",
                      "instance_id": "instance_4e1042d5f120",
                      "name": "Копирование файлов RAW в папку сессии",
                      "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "do_source_dir": {
                          "value": "{wf_raw_path}",
                          "enabled": true
                        },
                        "do_dest_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Capture/{wf_photo_session}",
                          "enabled": true
                        },
                        "do_mode": {
                          "value": "copy",
                          "enabled": true
                        },
                        "do_on_conflict": {
                          "value": "overwrite",
                          "enabled": true
                        },
                        "do_copy_base_folder": {
                          "value": false,
                          "enabled": true
                        },
                        "do_include": {
                          "value": "*.cr3",
                          "enabled": true
                        },
                        "all_threads": {
                          "value": "12",
                          "enabled": true
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_2d9191cafd07",
                  "name": "Этап 2.1. Анализ RAW-файлов",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_790d968b/Workflow/analize/export_to_jpeg",
                      "instance_id": "instance_2541c04a995a",
                      "name": "1. Конвертировать RAW в JPEG",
                      "description": "<div style=\"{theme.script_description}\">\n<b>Первый шаг в конвейере анализа изображений</b> \nСкрипт, конвертирует исходные файлы изображений (RAW или PSD) в формат JPEG для последующего анализа другими скриптами.\n\nПути к рабочим папкам формируется из переменных контекста: {wf_session_path}, {wf_session_name} и {wf_photo_session}:\n\n<b>base_dir</b> =<i> {wf_session_path} / {wf_session_name}</i>\n<b>input_dir</b> =<i> {base_dir} / Capture / {wf_photo_session}</i>\n<b>output_dir</b> =<i> {base_dir} / Output / Analysis_{wf_photo_session}  / JPG</i>\n\nЕсли ваши изображения уже в формате JPG, то данный скрипт можно не запускать.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "a_r2j_image_type": {
                          "value": "raw",
                          "enabled": true
                        },
                        "a_r2j_preview_size": {
                          "value": "2048",
                          "enabled": true
                        },
                        "a_r2j_jpeg_quality": {
                          "value": "90",
                          "enabled": true
                        },
                        "all_threads": {
                          "value": "12",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/img2mask",
                      "instance_id": "instance_c302eb9737de",
                      "name": "2. Создание маски фона",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "img_rmbg_input_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                          "enabled": true
                        },
                        "img_rmbg_output_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG/Masks",
                          "enabled": true
                        },
                        "img_rmbg_processor_type": {
                          "value": "birefnet",
                          "enabled": true
                        },
                        "img_rmbg_model_rmbg": {
                          "value": "RMBG-2.0",
                          "enabled": true
                        },
                        "img_rmbg_model_birefnet": {
                          "value": "BiRefNet-portrait",
                          "enabled": true
                        },
                        "img_rmbg_background": {
                          "value": "Solid",
                          "enabled": true
                        },
                        "img_rmbg_mask_blur": {
                          "value": "1",
                          "enabled": true
                        },
                        "img_rmbg_mask_offset": {
                          "value": "-1",
                          "enabled": true
                        },
                        "img_rmbg_save_options": {
                          "value": [
                            "image"
                          ],
                          "enabled": true
                        },
                        "img_rmbg_invert_mask": {
                          "value": true,
                          "enabled": true
                        },
                        "img_rmbg_fast_refine": {
                          "value": true,
                          "enabled": true
                        },
                        "img_rmbg_threads": {
                          "value": "12",
                          "enabled": true
                        },
                        "img_rmbg_sensitivity": {
                          "value": "0.5",
                          "enabled": true
                        },
                        "img_rmbg_img_scale": {
                          "value": "0",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/analyze_faces",
                      "instance_id": "instance_a8c39a1c7ee6",
                      "name": "3. Найти лица на фотографиях. Вычислить эмбединги",
                      "description": "<div style=\" {theme.script_description}\">\n<b>Второй по очереди (но главный по сути) скрипт в конвейере анализа изображений</b> \nСкрипт анализуирует изображения в формате JPG, распознает на них лица людей и переводит их в векторный формат (вычисляет эмбединги). Результаты анализа сохраняются в JSON и NPY-файлы (отдельно для портретных и групповых фотографий).\n\nПути к рабочим папкам формируется из переменных контекста: {wf_session_path}, {wf_session_name} и {wf_photo_session}.\n\n<b>base_dir</b> = <i>{wf_session_path} / {wf_session_name}</i>\n<b>output_dir</b> = <i>{base_dir} / Output / Analysis_{photo_session}</i>\n<b>input_dir</b> = <i>{output_dir} / JPG</i>\n\nСкрипт работает с файлами JPG, поэтому RAW и PSD файлы необходимо предварительно конвертировать.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "a_af_config_file": {
                          "value": "config.toml",
                          "enabled": true
                        },
                        "all_threads": {
                          "value": 0,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_portraits",
                      "instance_id": "instance_42266e06529f",
                      "name": "4. Кластеризация портретных фотографий",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "a_cp_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "a_cp_names_file": {
                          "value": "{wf_session_path}/{wf_session_name}/{wf_photo_session}_{wf_children_file_name}",
                          "enabled": true
                        },
                        "a_cp_config": {
                          "value": "config.toml",
                          "enabled": true
                        },
                        "a_cp_algorithm": {
                          "value": "dbscan",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_locations",
                      "instance_id": "instance_506298540e45",
                      "name": "5. Группировать фотографии по локациям",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "a_cl_config_file": {
                          "value": "config.toml",
                          "enabled": true
                        },
                        "a_cl_cluster_eps": {
                          "value": 0.14,
                          "enabled": true
                        },
                        "a_cl_location_prompts": {
                          "value": null,
                          "enabled": true
                        },
                        "all_threads": {
                          "value": 0,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/analyze_keypoints",
                      "instance_id": "instance_bd422c54312e",
                      "name": "6. Анализ атрибутов лица",
                      "description": "<div style=\" {theme.script_description}\">\n<b>Четвертый (<i>НЕОБАЗЯТЕЛЬНЫЙ</i>) скрипт в конвейере анализа изображений</b> \nСкрипт, на основании вычисленных ключевых точек <i>landmark_2d_106</i> и <i>landmark_3d_68</i>, анализирует атрибуты лица/головы: состояние глаз (открыты/закрыты) и рта (открыт/закрыт), поворота и наклона (вправо/влево/вверх/вниз).\nИнформация добавляется в файл JSON созданный скриптом №2.\n\nПути к рабочим папкам формируется из переменных контекста: {wf_session_path}, {wf_session_name}, {wf_photo_session} и {wf_children_file_name}.\n\n<b>base_dir</b> = <i>{wf_session_path} / {wf_session_name}</i> \n<b>data_dir</b> = <i>{base} / Output / Analysis_{wf_photo_session}</i>\n\nЕсли эти данные не нужны, то скрипт можно удалить из рабочеого процесса\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "a_ak_config_file": {
                          "value": "config.toml",
                          "enabled": true
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_4f936306fd96",
                  "name": "Этап 2.3. Ручное редактирование кластеров",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_msg",
                      "instance_id": "instance_ca9fc37081fd",
                      "name": "СООБЩЕНИЕ: Запустить редактор кластеров?",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт показывает диалоговое окно  для запуска/пропуска скриптов редактирования кластеров:\n- YES - последовательно запускаются скрипты редактирования кластеров портретных фотографий, кластеров локация и др.\n- NO  - скрипты редактирования кластеров пропускаются, выполнение текущего блока завершается\n\nВыбор пользователя сохраняется в переменной контекста <b>var_use_claster_editor</b>\n</div>",
                      "silent_mode": true,
                      "command_line_args": {
                        "dlg_msg_var": {
                          "value": "var_use_claster_editor",
                          "enabled": true
                        },
                        "dlg_msg_type": {
                          "value": "yes_no",
                          "enabled": true
                        },
                        "dlg_msg_title": {
                          "value": "Подтверждение",
                          "enabled": true
                        },
                        "dlg_msg_message": {
                          "value": "Следующий скрипт в очереди Редактор кластеров.\n\nВы хотите изменить структуру кластеров и/или экспортировать \nфотографии и отправить их родителями для выбора портретов?",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_editor",
                      "instance_id": "instance_695438502727",
                      "name": "Редактировать портретные кластеры",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ПОРТРЕТНЫХ фотографий (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session},\n- {wf_children_file_name}.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "ce_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "ce_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "mode": {
                          "value": "face",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_editor",
                      "instance_id": "instance_355076ddd213",
                      "name": "Редактировать кластеры локаций",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ЛОКАЦИЙ (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session},\n- {wf_children_file_name}.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "ce_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "ce_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "mode": {
                          "value": "location",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/py_if_else",
                      "instance_id": "instance_2fc4d244e10e",
                      "name": "УСЛОВИЕ 1: Проверка наличия портретных фотографий (да/нет)",
                      "description": "<div style=\" {theme.script_description}\">\nПроверка переменной контекста <b>var_another_session</b>\n\nВ зависимости от значения переменной выбирается  режим работы скрипта просмотра и экспорта фотографий из списка [ПОРТРЕТ-Групповые фотографии].\n\nЕсли значение равно:\n- YES - используются ПОРТРЕТЫ ТЕКУЩЕЙ ФОТОСЕССИИ (<b>БЛОК ИСТИНА</b>)\n- NO  - используются ЭТАЛОННЫЕ ПОРТРЕТЫ (<b>БЛОК ЛОЖЬ</b>)\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "if-variable-name": {
                          "value": "var_another_session",
                          "enabled": true
                        },
                        "if-operator": {
                          "value": "равно",
                          "enabled": true
                        },
                        "if-comparison-value": {
                          "value": "yes",
                          "enabled": true
                        },
                        "then-instance-id": {
                          "value": "instance_698f648d2679",
                          "enabled": true
                        },
                        "else-instance-id": {
                          "value": "instance_bf622a030abc",
                          "enabled": true
                        },
                        "clear-variable": {
                          "value": false,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_editor",
                      "instance_id": "instance_698f648d2679",
                      "name": "БЛОК ИСТИНА: Просмотр и экспорт списка [ПОРТРЕТ-Групповые фотографии]",
                      "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается в случае, когда  в текущей фотосессии ЕСТЬ портретные фотографии\n</div>\n<div style=\" {theme.script_description}\">\nЗапуск Редактора кластеров в режиме просмотра фотографий  [ПОРТРЕТ-Групповые фотографии]\n\nДля идентификации людей на групповых фотографиях текущей фотосессии <b>{wf_photo_session}</b> используются ПОРТРЕТЫ текущей фотосессии.\n\n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session}\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "ce_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "ce_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "mode": {
                          "value": "matches",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_goto",
                      "instance_id": "instance_792a9db0b62f",
                      "name": "БЛОК ИСТИНА: Завершение блока",
                      "description": "<div style=\" {theme.markup_number}\">\nФинальный скрипт <b>БЛОКА ИСТИНА</b> в скрипте управления <b>УСЛОВИЕ1</b>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт выполняет переход к первому скрипту после блока <b>БЛОКА ЛОЖЬ</b>\n</div>",
                      "silent_mode": true,
                      "command_line_args": {
                        "dlg_goto_title": {
                          "value": "Выбор следующего действия",
                          "enabled": true
                        },
                        "dlg_goto_message": {
                          "value": "Выберите скрипт, к которому нужно перейти:",
                          "enabled": true
                        },
                        "dlg_goto_script_id": {
                          "value": "instance_083ff0675826",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_editor",
                      "instance_id": "instance_bf622a030abc",
                      "name": "БЛОК ЛОЖЬ: Просмотр и экспорт списка [ЭТАЛОННЫЙ ПОРТРЕТ-Групповые фотографии]",
                      "description": "<div style=\" {theme.status_error}\">\nЭкземпляр скрипта запускается в случае, когда  в текущей фотосессии НЕТ портретных фотографий\n</div>\n<div style=\" {theme.script_description}\">\nЗапуск Редактора кластеров в режиме просмотра фотографий  [ЭТАЛОННЫЙ ПОРТРЕТ-Групповые фотографии]\n\nДля идентификации людей на групповых фотографиях текущей фотосессии <b>{wf_photo_session}</b> используются ПОРТРЕТЫ эталонной фотосессии <b>{wf_portrait_session}</b>\n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session},\n- {wf_portrait_session}\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "ce_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_portrait_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "ce_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "mode": {
                          "value": "matches",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/py_if_else",
                      "instance_id": "instance_083ff0675826",
                      "name": "УСЛОВИЕ 2: Наличие миниатюр с водяными знаками (да/нет)",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт проверяет переменную <b>var_jpg_move</b>, которая содержит информацию о выполнении операции экспорта фотографий в файлы JPG с водяными знаками.\n\nЕсли <b>var_jpg_move = yes</b>, то запускается скрипт перемещения файлов  JPG на Яндекс-диск (для отправки родителям)\n</div>",
                      "silent_mode": true,
                      "command_line_args": {
                        "if-variable-name": {
                          "value": "var_jpg_move",
                          "enabled": true
                        },
                        "if-operator": {
                          "value": "равно",
                          "enabled": true
                        },
                        "if-comparison-value": {
                          "value": "1",
                          "enabled": true
                        },
                        "then-instance-id": {
                          "value": "instance_f82a3defce6d",
                          "enabled": true
                        },
                        "else-instance-id": {
                          "value": "instance_bc39769fde8b",
                          "enabled": true
                        },
                        "clear-variable": {
                          "value": true,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/dir_operation",
                      "instance_id": "instance_f82a3defce6d",
                      "name": "БЛОК ИСТИНА: Перемещение файлов JPG в папку для выбора",
                      "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается если раньше была выполнена операция экспорта фотографий в файлы JPG с водяными знаками.\nПеременная контекста <i>var_jpg_move = yes</i>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт перемещает отсортированные папки с файлами JPG (c потретными и/или фотографиями с водяными знаками) на Яндекс-диск.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "do_source_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
                          "enabled": true
                        },
                        "do_dest_dir": {
                          "value": "{wf_psd_path}/{wf_session_name}",
                          "enabled": true
                        },
                        "do_mode": {
                          "value": "move",
                          "enabled": true
                        },
                        "do_on_conflict": {
                          "value": "overwrite",
                          "enabled": true
                        },
                        "do_copy_base_folder": {
                          "value": false,
                          "enabled": true
                        },
                        "do_include": {
                          "value": "*.jpg",
                          "enabled": true
                        },
                        "all_threads": {
                          "value": "8",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/cli_var_remove",
                      "instance_id": "instance_bc39769fde8b",
                      "name": "Удаление переменной var_jpg_move (есть файлы для перемещения)",
                      "description": "Удаление переменной var_jpg_move.\nПеременная автоматически создается при любом экспорте файлов в Редакторе кластеров.",
                      "silent_mode": false,
                      "command_line_args": {
                        "remove_var_name": {
                          "value": "var_jpg_move",
                          "enabled": true
                        },
                        "remove_fail_if_missing": {
                          "value": null,
                          "enabled": false
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_b649b6827c2f",
                  "name": "Этап 2.2. Идентификация лиц на групповых фотографиях",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_msg",
                      "instance_id": "instance_a0b60d844524",
                      "name": "СООБЩЕНИЕ: Идентификация людей на групповых фотографиях",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт показывает диалоговое окно  для выбора режима работы скрипта идентификации людей на групповых фотографиях:\n- YES - использовать ПОРТРЕТЫ ТЕКУЩЕЙ ФОТОСЕССИИ \n- NO  - использовать ЭТАЛОННЫЕ ПОРТРЕТЫ (если они у вас есть)\n- CANCEL - отменить выполнение скриптов этого блока\n\nВыбор пользователя сохраняется в переменной контекста <b>var_another_session</b>\n</div>",
                      "silent_mode": true,
                      "command_line_args": {
                        "dlg_msg_var": {
                          "value": "var_another_session",
                          "enabled": true
                        },
                        "dlg_msg_type": {
                          "value": "yes_no_cancel",
                          "enabled": true
                        },
                        "dlg_msg_title": {
                          "value": "Блок скриптов для идентификации людей на групповых фотографиях",
                          "enabled": true
                        },
                        "dlg_msg_message": {
                          "value": "Выберите режим работы скрипта идентификации людей на групповых фотографиях:\n\nYES - использовать ПОРТРЕТЫ ТЕКУЩЕЙ ФОТОСЕССИИ \n\nNO  - использовать ЭТАЛОННЫЕ ПОРТРЕТЫ (если они у вас есть)\n\nCANCEL - отменить выполнение скриптов этого блока",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/py_if_else",
                      "instance_id": "instance_537441f46127",
                      "name": "УСЛОВИЕ: Идентифицировать людей используя ПОРТРЕТЫ ТЕКУЩЕЙ фотосессии?",
                      "description": "<div style=\" {theme.script_description}\">\nПроверка переменной контекста <b>var_another_session</b>\n\nВ зависимости от значения переменной выбирается  режим работы скрипта идентификации людей на групповых фотографиях.\n\nЕсли значение равно:\n- YES - используются ПОРТРЕТЫ ТЕКУЩЕЙ ФОТОСЕССИИ (<b>БЛОК ИСТИНА</b>)\n- NO  - используются ЭТАЛОННЫЕ ПОРТРЕТЫ (<b>БЛОК ЛОЖЬ</b>)\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "if-variable-name": {
                          "value": "var_another_session",
                          "enabled": true
                        },
                        "if-operator": {
                          "value": "равно",
                          "enabled": true
                        },
                        "if-comparison-value": {
                          "value": "yes",
                          "enabled": true
                        },
                        "then-instance-id": {
                          "value": "instance_86c01d79d6cb",
                          "enabled": true
                        },
                        "else-instance-id": {
                          "value": "instance_9ed8119d2e55",
                          "enabled": true
                        },
                        "clear-variable": {
                          "value": false,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/match_group_faces",
                      "instance_id": "instance_86c01d79d6cb",
                      "name": "БЛОК ИСТИНА: Идентификация людей на групповых фотографиях используя ПОРТРЕТЫ ТЕКУЩЕЙ фотосессии",
                      "description": "<div style=\" {theme.markup_number}\">\nЭкземпляр скрипта запускается в случае, когда  в текущей фотосессии ЕСТЬ портретные фотографии\n</div>\n<div style=\" {theme.script_description}\">\nИдентифицирует людей на групповых фотографиях, сопоставляя их с ранее созданными портретными кластерами ТЕКУЩЕЙ ФОТОСЕССИИ\n\nДля работы скрипта необходим файл <b>info_portrait_faces.json</b>(информация о портретных кластерах), созданный при анализе RAW-файлов.\n\nСкрипт обновляет файл <b>info_group_faces.json</b> и создает список соответствия  <b>[ПОРТРЕТ-Групповые фотографии]</b> (файл <b>matches_portrait_to_group.json</b>)\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "a_mg_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "a_mg_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "a_mg_config": {
                          "value": "config.toml",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_goto",
                      "instance_id": "instance_b17d8a53532d",
                      "name": "БЛОК ИСТИНА: Завершение блока",
                      "description": "<div style=\" {theme.markup_number}\">\nФинальный скрипт <b>БЛОКА ИСТИНА</b> в скрипте управления <b>УСЛОВИЕ</b>\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт выполняет переход к первому скрипту после блока <b>БЛОКА ЛОЖЬ</b>\n</div>",
                      "silent_mode": true,
                      "command_line_args": {
                        "dlg_goto_title": {
                          "value": "Выбор следующего действия",
                          "enabled": true
                        },
                        "dlg_goto_message": {
                          "value": "Выберите скрипт, к которому нужно перейти:",
                          "enabled": true
                        },
                        "dlg_goto_script_id": {
                          "value": "instance_51940b554830",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_choice",
                      "instance_id": "instance_9ed8119d2e55",
                      "name": "БЛОК ЛОЖЬ: Выбор эталонной ПОРТРЕТНОЙ съемки",
                      "description": "<div style=\" {theme.status_error}\">\nЭкземпляр скрипта запускается в случае, когда  в текущей фотосессии НЕТ портретных фотографий\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт запускает диалог выбора ЭТАЛОННОЙ ФОТОСЕССИИ, в которой есть портретные фотографии.\n\nНазвание ЭТАЛОННОЙ ФОТОСЕССИИ сохраняется в переменной контекста <b>wf_portrait_session</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session},\n- {wf_portrait_session}\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_choice_var": {
                          "value": "wf_portrait_session",
                          "enabled": true
                        },
                        "dlg_choice_title": {
                          "value": "Выбор съемки",
                          "enabled": true
                        },
                        "dlg_choice_message": {
                          "value": "Выберите ЭТАЛОННУЮ съемку с портретными фотографиями \nдля точной идентификации лиц на групповых фотографиях.\n\nВыберите название съемки в выпадающем списке:\n",
                          "enabled": true
                        },
                        "dlg_choice_list": {
                          "value": [
                            "PORTRAIT",
                            "SCHOOL",
                            "SEPTEMBER1",
                            "STREET",
                            "STUDIO"
                          ],
                          "enabled": true
                        },
                        "dlg_choice_dvalue": {
                          "value": "PORTRAIT",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/match_group_faces",
                      "instance_id": "instance_4d5f079c400a",
                      "name": "БЛОК ЛОЖЬ: Идентификация людей на групповых фотографиях по ЭТАЛОННЫМ ПОРТРЕТАМ",
                      "description": "<div style=\" {theme.status_error}\">\nЭкземпляр скрипта запускается в случае, когда  в текущей фотосессии НЕТ портретных фотографий\n</div>\n<div style=\"{theme.markup_number}\">\nИдентифицирует людей на групповых фотографиях, сопоставляя их с портретными кластерами ЭТАЛОННОЙ ФОТОСЕССИИ\n\nДля работы скрипта необходим файл <b>info_portrait_faces.json</b>(информация о портретных кластерах), созданный при анализе RAW-файлов.\n\nСкрипт обновляет файл <b>info_group_faces.json</b> и создает список соответствия  <b>[ЭТАЛОННЫЙ ПОРТРЕТ-Групповые фотографии]</b> (файл <b>matches_portrait_to_group.json</b>)\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "a_mg_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_portrait_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "a_mg_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "a_mg_config": {
                          "value": "config.toml",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/cli_var_remove",
                      "instance_id": "instance_51940b554830",
                      "name": "Удаление переменной var_jpg_move (есть файлы для перемещения)",
                      "description": "Удаление переменной var_jpg_move.\nПеременная автоматически создается при любом экспорте файлов в Редакторе кластеров.",
                      "silent_mode": false,
                      "command_line_args": {
