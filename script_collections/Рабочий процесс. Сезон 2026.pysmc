                    "dlg_input_custom_regexp_desc": {
                      "value": null,
                      "enabled": false
                    }
                  }
                },
                {
                  "id": "root_790d968b/Workflow/wf_session_create",
                  "instance_id": "instance_a5f254cb0a97",
                  "name": "Создать сессию Capture One",
                  "description": null,
                  "silent_mode": false,
                  "command_line_args": {
                    "wf_session_name": {
                      "value": "{wf_session_name}",
