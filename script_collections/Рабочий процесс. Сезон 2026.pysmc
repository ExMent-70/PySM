                        "validate": {
                          "value": false,
                          "enabled": true
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_d6f038620f20",
                  "name": "Этап R6. Завершить работу (один раз для каждого класса(группы)",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_790d968b/Photoshop/ps_photoshop_launch",
