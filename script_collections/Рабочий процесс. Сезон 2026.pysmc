                  }
                },
                {
                  "id": "root_7617c03c/SYSTEM/dir_operation",
                  "instance_id": "instance_e2320d14a6dc",
                  "name": "Перемещение PSD-файлов в папку для ретуши",
                  "description": "<div style=\" {theme.script_description}\">\nПеремещает/копирует PSD-файлы, экспортированные из Capture One, в папку для ретуши. При выполнении скрипта сохраняется  структура исходных папок.<br>\nПри работе с реальными данными рекомендуется установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке рабочего процессе использовать режим <b>copy</b></div>",
                  "silent_mode": true,
                  "command_line_args": {
                    "do_source_dir": {
                      "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
                      "enabled": true
                    },
                    "do_dest_dir": {
                      "value": "{wf_psd_path}/{wf_session_name}",
                      "enabled": true
                    },
                    "do_mode": {
                      "value": "move",
                      "enabled": true
                    },
                    "do_on_conflict": {
                      "value": "overwrite",
                      "enabled": true
                    },
                    "do_copy_base_folder": {
                      "value": false,
                      "enabled": true
                    },
                    "do_include": {
                      "value": [
                        "*.psd"
                      ],
                      "enabled": true
                    },
                    "all_threads": {
                      "value": "12",
                      "enabled": true
                    }
                  }
                }
              ]
            },
            {
              "type": "set_folder",
              "id": "foldernode_3ce71ff58ab7",
              "name": "Рабочий процесс RAW",
