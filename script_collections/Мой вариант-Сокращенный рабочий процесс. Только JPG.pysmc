            {
              "type": "set_folder",
              "id": "foldernode_bdbc734bae99",
              "name": "Этапы рабочего процесса",
              "description": null,
              "children": [
                {
                  "type": "script_set",
                  "id": "setnode_8bc1931219c3",
                  "name": "Этап 1. Подготовка  и анализ исходных файлов. Для каждой фотосессии",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_choice",
                      "instance_id": "instance_56229ce6612a",
                      "name": "Выбор съемки (портретная, студийная, школьная и т.д.)",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_choice_var": {
                          "value": "wf_photo_session",
                          "enabled": true
                        },
                        "dlg_choice_title": {
                          "value": "Выбор съемки",
                          "enabled": true
                        },
                        "dlg_choice_message": {
                          "value": "Если договором предусмотрено несколько съемок\n(например: портретная, студийная, школьная и т.д.),\nукажите название текущей съемки.\n\nВыберите название съемки в выпадающем списке:\n",
                          "enabled": true
                        },
                        "dlg_choice_list": {
                          "value": [
                            "PORTRAIT",
                            "SCHOOL",
                            "SEPTEMBER1",
                            "STREET",
                            "STUDIO"
                          ],
                          "enabled": true
                        },
                        "dlg_choice_dvalue": {
                          "value": "",
                          "enabled": false
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_open",
                      "instance_id": "instance_54d01d32a906",
                      "name": "ДИАЛОГ: Выбрать папку с исходными файлами",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_open_var": {
                          "value": "wf_raw_path",
                          "enabled": true
                        },
                        "dlg_open_type": {
                          "value": "directory",
                          "enabled": true
                        },
                        "dlg_open_title": {
                          "value": "Выбрать папку с исходными файлами",
                          "enabled": true
                        },
                        "dlg_open_filter": {
                          "value": "Все файлы (*.*)",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/dir_operation",
                      "instance_id": "instance_7be9540f7fa3",
                      "name": "Копирование исходных файлов в рабочую папку",
                      "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "do_source_dir": {
                          "value": "{wf_raw_path}",
                          "enabled": true
                        },
                        "do_dest_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                          "enabled": true
                        },
                        "do_mode": {
                          "value": "copy",
                          "enabled": true
                        },
                        "do_on_conflict": {
                          "value": "overwrite",
                          "enabled": true
                        },
                        "do_copy_base_folder": {
                          "value": false,
                          "enabled": true
                        },
                        "do_include": {
                          "value": [
                            "*",
                            "*.jpg",
                            "*.jpeg"
                          ],
                          "enabled": true
                        },
                        "all_threads": {
                          "value": "12",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/img2mask",
                      "instance_id": "instance_71f54539e737",
                      "name": "Создание маски фона",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "img_rmbg_input_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                          "enabled": true
                        },
                        "img_rmbg_output_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG/Masks",
                          "enabled": true
                        },
                        "img_rmbg_processor_type": {
                          "value": "birefnet",
                          "enabled": true
                        },
                        "img_rmbg_model_rmbg": {
                          "value": "RMBG-2.0",
                          "enabled": true
                        },
                        "img_rmbg_model_birefnet": {
                          "value": "BiRefNet-portrait",
                          "enabled": true
                        },
                        "img_rmbg_background": {
                          "value": "Solid",
                          "enabled": true
                        },
                        "img_rmbg_mask_blur": {
                          "value": "1",
                          "enabled": true
                        },
                        "img_rmbg_mask_offset": {
                          "value": "-1",
                          "enabled": true
                        },
                        "img_rmbg_save_options": {
                          "value": [
                            "image"
                          ],
                          "enabled": true
                        },
                        "img_rmbg_invert_mask": {
                          "value": true,
                          "enabled": true
                        },
                        "img_rmbg_fast_refine": {
                          "value": true,
                          "enabled": true
                        },
                        "img_rmbg_threads": {
                          "value": "12",
                          "enabled": true
                        },
                        "img_rmbg_sensitivity": {
                          "value": "0.5",
                          "enabled": true
                        },
                        "img_rmbg_img_scale": {
                          "value": "0",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/analyze_faces",
                      "instance_id": "instance_d6976ad7a53a",
                      "name": "Найти лица на фотографиях. Вычислить эмбединги",
                      "description": "<div style=\" {theme.script_description}\">\n<b>Второй по очереди (но главный по сути) скрипт в конвейере анализа изображений</b> \nСкрипт анализуирует изображения в формате JPG, распознает на них лица людей и переводит их в векторный формат (вычисляет эмбединги). Результаты анализа сохраняются в JSON и NPY-файлы (отдельно для портретных и групповых фотографий).\n\nПути к рабочим папкам формируется из переменных контекста: {wf_session_path}, {wf_session_name} и {wf_photo_session}.\n\n<b>base_dir</b> = <i>{wf_session_path} / {wf_session_name}</i>\n<b>output_dir</b> = <i>{base_dir} / Output / Analysis_{photo_session}</i>\n<b>input_dir</b> = <i>{output_dir} / JPG</i>\n\nСкрипт работает с файлами JPG, поэтому RAW и PSD файлы необходимо предварительно конвертировать.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "a_af_config_file": {
                          "value": "config.toml",
                          "enabled": true
                        },
                        "all_threads": {
                          "value": 0,
                          "enabled": true
                        },
                        "a_af_det_thresh": {
                          "value": "0.4",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/cli_var_remove",
                      "instance_id": "instance_ed37399061e6",
                      "name": "Удаление переменной var_jpg_move",
                      "description": "<div style=\" {theme.script_description}\">\nУдаление переменной <b>var_jpg_move</b>.\n\nПеременная автоматически создается при любом экспорте файлов в Редакторе кластеров.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "remove_var_name": {
                          "value": "var_jpg_move",
                          "enabled": true
                        },
                        "remove_fail_if_missing": {
                          "value": null,
                          "enabled": false
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_f5f439768d60",
                  "name": "Этап 2.1. Кластеризация портретов",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_msg",
                      "instance_id": "instance_6e32392fd405",
                      "name": "СООБЩЕНИЕ: Запустить редактор кластеров",
                      "description": null,
                      "silent_mode": true,
                      "command_line_args": {
                        "dlg_msg_var": {
                          "value": "var_use_claster_editor",
                          "enabled": true
                        },
                        "dlg_msg_type": {
                          "value": "yes_no",
                          "enabled": true
                        },
                        "dlg_msg_title": {
                          "value": "Подтверждение",
                          "enabled": true
                        },
                        "dlg_msg_message": {
                          "value": "Набор скриптов для кластеризации портретов\n\nВыполнение этих скриптов измененит следующие файлы:\n- info_group_faces.json\n- info_portrait_faces.json\n\nВы хотите выполнить скрипты входящие в этот набор?",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/log_html",
                      "instance_id": "instance_4920bd3f0cd6",
                      "name": "СООБЩЕНИЕ: Список с порядковым номерам съемки",
                      "description": null,
                      "silent_mode": true,
                      "command_line_args": {
                        "html_content": {
                          "value": "{wf_html_text_02}",
                          "enabled": true
                        },
                        "html_file": {
                          "value": null,
                          "enabled": false
                        },
                        "html_align": {
                          "value": "left",
                          "enabled": true
                        },
                        "html_margin": {
                          "value": 5,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/wf_list_create",
                      "instance_id": "instance_46b2b3def746",
                      "name": "Добавить порядковый номер съемки в список класса/группы",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "wf_dest_dir": {
                          "value": "{wf_psd_path}/{wf_session_name}",
                          "enabled": true
                        },
                        "wf_output_txt_file": {
                          "value": "{wf_session_path}/{wf_session_name}/{wf_photo_session}_{wf_children_file_name}",
                          "enabled": true
                        },
                        "wf_autosave_formats": {
                          "value": [
                            "html",
                            "txt"
                          ],
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_portraits",
                      "instance_id": "instance_9b5f41d21885",
                      "name": "Кластеризация портретных фотографий",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "a_cp_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "a_cp_names_file": {
                          "value": "{wf_session_path}/{wf_session_name}/{wf_photo_session}_{wf_children_file_name}",
                          "enabled": true
                        },
                        "a_cp_config": {
                          "value": "config.toml",
                          "enabled": true
                        },
                        "a_cp_algorithm": {
                          "value": "dbscan",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/Workflow/analize/cluster_editor",
                      "instance_id": "instance_64b4a500c938",
                      "name": "Редактор портретных кластеров",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт позволяет визуально, в ручном режиме, редактировать кластеры ПОРТРЕТНЫХ фотографий (просматривать и удалять фотографии кластера, перемещать их из одного кластера в другой, изменять название кластера). \n\nДополнительно в скрипте реализован экспорт изображений в формат JPG с водяными знаками. При экспорте переменной контекста <b>var_jpg_move</b> присваивается значение <b>yes</b>\n<b>var_jpg_move = yes</b>\n\nПути к рабочим папкам формируется из переменных контекста: \n- {wf_session_path}, \n- {wf_session_name}, \n- {wf_photo_session},\n- {wf_children_file_name}.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "ce_portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "ce_group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "mode": {
                          "value": "face",
                          "enabled": true
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_f964e2a8e1f8",
                  "name": "Этап 2.2. Кластеризация локаций",
                  "description": null,
                  "script_entries": [
