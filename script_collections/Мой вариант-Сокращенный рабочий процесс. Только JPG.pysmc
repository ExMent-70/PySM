                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_choice",
                      "instance_id": "instance_869767596673",
                      "name": "БЛОК ЛОЖЬ: Выбор эталонной ПОРТРЕТНОЙ съемки",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_choice_var": {
