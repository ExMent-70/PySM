                {
                  "id": "root_790d968b/Workflow/wf_session_create",
                  "instance_id": "instance_bde42149a6de",
                  "name": "Создать структуру рабочих папок",
                  "description": null,
                  "silent_mode": false,
                  "command_line_args": {
