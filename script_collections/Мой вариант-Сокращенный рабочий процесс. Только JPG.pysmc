                          "enabled": true
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_e37bc6324a04",
                  "name": "Этап 3. Копирование JPG файлов в папку верстки альбома (Для каждой фотосессии)",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_790d968b/Workflow/analize/wf_photo_copy",
                      "instance_id": "instance_02e7ea20873a",
                      "name": "Отметить фотографии выбранные клиентами (JPG файлы)",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт идентифицирует в неструктурированном тексте номера фотографий выбранных пользователем.\n\nЗатем ищет в исходной папке JPG-файлы, в именах которых содержатся указанные номера. \n\nВ настройках скрипта установлены опции копирования и переименования найденных файлов в целевую папку.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "portrait_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_portrait_faces.json",
                          "enabled": true
                        },
                        "group_json": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/info_group_faces.json",
                          "enabled": true
                        },
                        "source_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/JPG",
                          "enabled": true
                        },
                        "dest_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
                          "enabled": true
                        },
                        "min_digits": {
                          "value": "4",
                          "enabled": true
                        },
                        "max_digits": {
                          "value": "4",
                          "enabled": true
                        },
                        "exclude_dirs": {
                          "value": "Masks",
                          "enabled": true
                        },
                        "update-xmp": {
                          "value": false,
                          "enabled": true
                        },
                        "rename-files": {
                          "value": true,
                          "enabled": true
                        },
                        "copy-files": {
                          "value": true,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/SYSTEM/dir_operation",
                      "instance_id": "instance_cf07108ec60f",
                      "name": "Перемещение файлов JPG в папку Альбом",
                      "description": "<div style=\" {theme.script_description}\">При работе с реальными данными установить режим работы <b>do_mode</b> в состояние <b>move</b>. При отладке используется режим <b>copy</b></div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "do_source_dir": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/{wf_session_name}",
                          "enabled": true
                        },
                        "do_dest_dir": {
                          "value": "{wf_psd_path}/{wf_session_name}",
                          "enabled": true
                        },
                        "do_mode": {
                          "value": "move",
                          "enabled": true
                        },
                        "do_on_conflict": {
                          "value": "overwrite",
                          "enabled": true
                        },
                        "do_copy_base_folder": {
                          "value": false,
                          "enabled": true
                        },
                        "do_include": {
                          "value": [
                            "*.jpg",
                            "*.jpeg"
                          ],
                          "enabled": true
                        },
                        "all_threads": {
                          "value": "8",
                          "enabled": true
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "script_set",
                  "id": "setnode_808d20fdf47a",
                  "name": "Этап 4. Автоматическая верстка",
                  "description": null,
                  "script_entries": [
                    {
                      "id": "root_7617c03c/SYSTEM/py_if_else",
                      "instance_id": "instance_66b8fdfbaafe",
                      "name": "УСЛОВИЕ: Проверка КАТАЛОГА ШАБЛОНОВ",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт проверяет наличие переменной <b>wf_idsgn_catalog</b>, которая содержит путь к каталогу шаблонов InDesign.\n\nЕсли переменная не существует, то программа предлагает выбрать файл-каталог шаблонов.\nЕсли переменная существует, то запускается скрипт каталогизатор.\n</div>",
                      "silent_mode": true,
                      "command_line_args": {
                        "if-variable-name": {
                          "value": "wf_idsgn_catalog",
                          "enabled": true
                        },
                        "if-operator": {
                          "value": "равно",
                          "enabled": true
                        },
                        "if-comparison-value": {
                          "value": "None",
                          "enabled": true
                        },
                        "then-instance-id": {
                          "value": "instance_ce10476e6056",
                          "enabled": true
                        },
                        "else-instance-id": {
                          "value": "instance_13c4d154ed23",
                          "enabled": true
                        },
                        "clear-variable": {
                          "value": false,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_7617c03c/GUI/gui_dialog_open",
                      "instance_id": "instance_ce10476e6056",
                      "name": "БЛОК ИСТИНА: Открыть файл-каталог шаблонов InDesign",
                      "description": "<div style=\" {theme.markup_number}\">\nСкрипт запускается если не выбран каталог шаблонов InDesign.\n</div>\n<div style=\" {theme.script_description}\">\nСкрипт открывает диалоговое окно для выбора пути к файлу-каталогу шаблонов InDesign.\n\nВыбранный путь сохраняется в переменную контекста <b>wf_idsgn_catalog</b>.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "dlg_open_var": {
                          "value": "wf_idsgn_catalog",
                          "enabled": true
                        },
                        "dlg_open_type": {
                          "value": "file",
                          "enabled": true
                        },
                        "dlg_open_title": {
                          "value": "Выберите файл-каталог шаблонов InDesign",
                          "enabled": true
                        },
                        "dlg_open_filter": {
                          "value": "*.template",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/InDesign/ID_CATALOG_Julietta_Rose",
                      "instance_id": "instance_f069d00d3e28",
                      "name": "Выбрать шаблон оформления",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт для выбора шаблона InDesign, который будет использован в скрипте автоматической верстки.\n\nВсе параметры выбранного шаблона сохраняются в переменной контекста <b>var_template_name</b>.\n\nДля работы скрипта путь к каталогу шаблонов должен быть предварительно сохранен в переменной <b>wf_idsgn_catalog</b>.\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "idsgn_catalog": {
                          "value": "{wf_idsgn_catalog}",
                          "enabled": true
                        },
                        "idsgn_template_var": {
                          "value": "var_template_name",
                          "enabled": true
                        },
                        "idsgn_msg": {
                          "value": "Каталогизатор шаблонов InDesign",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/InDesign/ID_GENERATOR_Julietta_Rose",
                      "instance_id": "instance_333360aba482",
                      "name": "Сгенерировать новый разворот",
                      "description": "<div style=\" {theme.script_description}\">\nСкрипт на основе шаблона, сохраненного в переменной <b>var_template_name</b>, генерирует многостраничный файл InDesign, заполняя персональные развороты для каждой ученика.\n\nВ данном Экземпляре скрипта пути к JSON-файлу с информацией об учениках, папке с фотографиями вычисляются автоматически на основании переменных контекста:\n- {wf_session_path}\n- {wf_psd_path}\n- {wf_session_name}\n- {wf_photo_session}\n</div>",
                      "silent_mode": false,
                      "command_line_args": {
                        "template": {
                          "value": "var_template_name",
                          "enabled": true
                        },
                        "output_file": {
                          "value": "",
                          "enabled": false
                        },
                        "data_json_file": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/matches_portrait_to_group.json",
                          "enabled": true
                        },
                        "source_photos_dir": {
                          "value": "{wf_psd_path}/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
                          "enabled": true
                        },
                        "placeholder_image": {
                          "value": "placeholder.png",
                          "enabled": true
                        },
                        "validate": {
                          "value": false,
                          "enabled": true
                        },
                        "generation_mode": {
                          "value": "auto",
                          "enabled": true
                        },
                        "magic_word": {
                          "value": "База",
                          "enabled": true
                        },
                        "face_scale": {
                          "value": 0.8,
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/InDesign/idsgn_catalog",
                      "instance_id": "instance_0c4e51d41df0",
                      "name": "idsgn_catalog",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "idsgn_catalog": {
                          "value": "{wf_idsgn_catalog}",
                          "enabled": true
                        },
                        "idsgn_template_var": {
                          "value": "var_template_name",
                          "enabled": true
                        },
                        "idsgn_msg": {
                          "value": "Каталогизатор шаблонов InDesign",
                          "enabled": true
                        }
                      }
                    },
                    {
                      "id": "root_790d968b/InDesign/idsgn_spread_generator",
                      "instance_id": "instance_82cd46183277",
                      "name": "idsgn_spread_generator",
                      "description": null,
                      "silent_mode": false,
                      "command_line_args": {
                        "template": {
                          "value": "var_template_name",
                          "enabled": true
                        },
                        "output_file": {
                          "value": "",
                          "enabled": true
                        },
                        "data_json_file": {
                          "value": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}/matches_portrait_to_group.json",
                          "enabled": true
                        },
                        "source_photos_dir": {
                          "value": "{wf_psd_path}/{wf_session_name}/Альбом/Фото/{wf_photo_session}",
                          "enabled": true
                        },
                        "placeholder_image": {
                          "value": "placeholder.png",
                          "enabled": true
                        },
                        "validate": {
                          "value": false,
                          "enabled": true
                        },
                        "generation_mode": {
                          "value": "auto",
                          "enabled": true
                        },
                        "magic_word": {
                          "value": "База",
                          "enabled": true
                        },
                        "face_scale": {
                          "value": 0.8,
                          "enabled": true
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
