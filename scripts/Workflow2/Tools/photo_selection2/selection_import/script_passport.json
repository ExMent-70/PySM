{
  "description": "Импорт и ручное редактирование выбора учеников. Сохраняет только photo_selection.json.",
  "category": "Редакторы",
  "author": "Андрей Пугачев | t.me/pugachev_fotodeti03",
  "version": "2.2026.09.17",
  "command_line_args_meta": {
    "student_list_file": {
      "type": "file_path",
      "description": "Список класса/группу содержащий имена и фамилий *.list.",
      "required": true,
      "default": "{wf_psd_path}/{wf_session_name}/{wf_session_name}.list"
    },
    "analysis_dir": {
      "type": "dir_path",
      "description": "Папка с photo_selection.json.",
      "required": true,
      "default": "{wf_session_path}/{wf_session_name}/Output/Analysis_{wf_photo_session}"
    },
    "session_name": {
      "type": "str",
      "description": "Уникальный идентификатор класса/группы",
      "required": true,
      "default": "{wf_session_name}"
    },
    "photo_session": {
      "type": "str",
      "description": "Название текущей фотосессии.",
      "required": true,
      "default": "{wf_photo_session}"
    },
    "title": {
      "type": "str",
      "description": "Заголовок главного окна.",
      "required": false,
      "default": "Импорт выбора фотографий"
    },
    "message": {
      "type": "string_multiline",
      "description": "HTML-инструкция, выводимая первым блоком правой информационной панели.",
      "required": false,
      "default": ""
    }
  }
}
