/* themes/retro_terminal/style.qss - Стиль ЭЛТ-монитора */

/* --- 1. Общие стили --- */
QWidget {
    background-color: #0A0F0A; /* Глубокий, почти черный с оттенком зеленого */
    color: #33FF33;            /* Классический ярко-зеленый */
    font-family: "Consolas", "Lucida Console", "Courier New", monospace;
    font-size: 10pt;
    border-radius: 0px; /* Никаких скругленных углов */
}
QLabel, QCheckBox { background-color: transparent; border: none; }

/* --- 2. Контейнеры и вкладки --- */
QGroupBox, QTabWidget::pane {
    background-color: #0A0F0A;
    border: 1px solid #1A4A1A; /* Темно-зеленая рамка */
}
QGroupBox { margin-top: 15px; }
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top center;
    padding: 2px 8px; top: -1px;
    background-color: #1A4A1A;
    color: #33FF33;
    border: 1px solid #1A4A1A;
}
QTabWidget::pane { margin-top: 0px; }
QTabBar::tab {
    background: #0A0F0A; border: 1px solid #1A4A1A;
    padding: 7px 15px;
}
QTabBar::tab:selected { background: #33FF33; color: #0A0F0A; font-weight: bold; }
QTabBar::tab:!selected:hover { background: #1A4A1A; }

QToolBox::tab { background: #1A4A1A; border: none; color: #33FF33; padding: 6px; }
QToolBox::tab:selected, QToolBox::tab:hover { background: #33FF33; color: #0A0F0A; }
QToolBox QWidget, QToolBox QTextEdit { background-color: #0A0F0A; color: #33FF33; border: none; }

/* --- 3. Кнопки --- */
QPushButton { background-color: transparent; color: #33FF33; border: 1px solid #33FF33; padding: 6px 12px; }
QPushButton:hover { background-color: #1A4A1A; }
QPushButton:pressed { background-color: #33FF33; color: #0A0F0A; }
QPushButton:disabled { color: #1A4A1A; border-color: #1A4A1A; }

QToolBar { background-color: #0A0F0A; border-bottom: 1px solid #1A4A1A; }
QStatusBar { background-color: #1A4A1A; color: #33FF33; }
QToolBar QToolButton { border: 1px solid #0A0F0A; padding: 5px; }
QToolBar QToolButton:hover, QToolBar QToolButton:checked { background-color: #1A4A1A; border: 1px solid #33FF33; }
QToolBar QToolButton:pressed { background-color: #33FF33; border: 1px solid #33FF33; }

/* --- 4. Поля ввода, списки и таблицы --- */
QLineEdit, QTextEdit, QPlainTextEdit, QTreeView, QListWidget, QTableView#ProjectCrmCustomerTable, QTableView#ProjectCrmProjectTable, QComboBox, EmbeddedImageViewer {
    background-color: #0A0F0A; border: 1px solid #1A4A1A; padding: 4px; 
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid #33FF33; }
QLineEdit:disabled, QLineEdit:read-only { background-color: #050805; color: #1A4A1A; }

QTreeView, QListWidget, QTableView#ProjectCrmCustomerTable, QTableView#ProjectCrmProjectTable { alternate-background-color: #050805; }
QTreeView::item:hover, QListWidget::item:hover { background-color: #1A4A1A; }
/* Эффект блочного курсора/выделенной строки */
QTreeView::item:selected, QListWidget::item:selected, QTableView#ProjectCrmCustomerTable::item:selected, QTableView#ProjectCrmProjectTable::item:selected { background-color: #33FF33; color: #0A0F0A; }
QTreeWidget#InstanceSelectionTree::item,
QTreeWidget#InstanceSelectionTree::item:hover,
QTreeWidget#InstanceSelectionTree::item:selected,
QTreeWidget#InstanceSelectionTree::item:selected:active,
QTreeWidget#InstanceSelectionTree::item:selected:!active {
    border: none;
    padding: 0px 2px;
}

QHeaderView::section { background-color: #1A4A1A; padding: 5px; border: 1px solid #33FF33; border-top: none; border-left: none; }
QTableWidget, QTableView#ProjectCrmCustomerTable, QTableView#ProjectCrmProjectTable { border: 1px solid #1A4A1A; gridline-color: #1A4A1A; }
QTableWidget::item:selected { background-color: #33FF33; color: #0A0F0A; }

/* --- 5. Элементы управления --- */
QComboBox::drop-down { border-left: 1px solid #1A4A1A; }
QComboBox::down-arrow { image: url(none); /* Можно добавить свою иконку */ }
QCheckBox::indicator, QTreeWidget::indicator {
    border: 1px solid #33FF33; background-color: #0A0F0A;
    width: 16px; height: 16px;
}
QTreeWidget::indicator,
QTreeWidget::indicator:unchecked,
QTreeWidget::indicator:checked,
QTreeWidget::indicator:indeterminate {
    border: 1px solid #33FF33;
    width: 16px; height: 16px; margin: 0px; padding: 0px;
}
QCheckBox::indicator:checked, QTreeWidget::indicator:checked {
    background-color: #33FF33; border: 1px solid #33FF33;
    width: 16px; height: 16px; margin: 0px; padding: 0px;
}
QTreeWidget::indicator:indeterminate {
    background-color: #33FF33; border: 1px solid #33FF33;
    width: 16px; height: 16px; margin: 0px; padding: 0px;
}
QProgressBar { border: 1px solid #33FF33; text-align: center; color: #33FF33; background-color: #0A0F0A; }
QProgressBar::chunk { background-color: #1A4A1A; }

/* --- 6. Полосы прокрутки --- */
QScrollBar:vertical, QScrollBar:horizontal { border: 1px solid #1A4A1A; background: #0A0F0A; width: 12px; height: 12px; }
QScrollBar::handle { background: #33FF33; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0px; width: 0px; }

/* --- 7. Меню и Подсказки --- */
QMenu { background-color: #0A0F0A; border: 1px solid #33FF33; }
QMenu::item:selected { background-color: #33FF33; color: #0A0F0A; }
QToolTip { background-color: #0A0F0A; color: #33FF33; border: 1px solid #33FF33; padding: 5px; }


/* --- 8. Календарные поля и календари --- */
QDateEdit[pysmCalendarField="true"], QTimeEdit[pysmCalendarField="true"], QDateTimeEdit[pysmCalendarField="true"] {
    background-color: #0A0F0A; color: #33FF33;
    border: 1px solid #1A4A1A; padding: 4px;
    selection-background-color: #33FF33; selection-color: #0A0F0A;
}
QDateEdit[pysmCalendarField="true"]:focus, QTimeEdit[pysmCalendarField="true"]:focus, QDateTimeEdit[pysmCalendarField="true"]:focus {
    border: 1px solid #33FF33;
}
QDateEdit[pysmCalendarField="true"]::up-button, QTimeEdit[pysmCalendarField="true"]::up-button, QDateTimeEdit[pysmCalendarField="true"]::up-button,
QDateEdit[pysmCalendarField="true"]::down-button, QTimeEdit[pysmCalendarField="true"]::down-button, QDateTimeEdit[pysmCalendarField="true"]::down-button {
    subcontrol-origin: border; width: 16px; background-color: #0A0F0A;
    border-left: 1px solid #1A4A1A;
}
QDateEdit[pysmCalendarField="true"]::up-button, QTimeEdit[pysmCalendarField="true"]::up-button, QDateTimeEdit[pysmCalendarField="true"]::up-button {
    subcontrol-position: top right; border-bottom: 1px solid #1A4A1A;
}
QDateEdit[pysmCalendarField="true"]::down-button, QTimeEdit[pysmCalendarField="true"]::down-button, QDateTimeEdit[pysmCalendarField="true"]::down-button {
    subcontrol-position: bottom right;
}
QDateEdit[pysmCalendarField="true"]::drop-down, QDateTimeEdit[pysmCalendarField="true"]::drop-down {
    subcontrol-origin: border; subcontrol-position: top right;
    width: 18px; background-color: #0A0F0A;
    border-left: 1px solid #1A4A1A;
}
QDateEdit[pysmCalendarField="true"]::drop-down:hover, QDateTimeEdit[pysmCalendarField="true"]::drop-down:hover {
    background-color: #1A4A1A;
}
QDateEdit[pysmCalendarField="true"]::up-button:hover, QTimeEdit[pysmCalendarField="true"]::up-button:hover,
QDateTimeEdit[pysmCalendarField="true"]::up-button:hover, QDateEdit[pysmCalendarField="true"]::down-button:hover,
QTimeEdit[pysmCalendarField="true"]::down-button:hover, QDateTimeEdit[pysmCalendarField="true"]::down-button:hover {
    background-color: #1A4A1A;
}
QDateEdit[pysmCalendarField="true"]::up-arrow, QTimeEdit[pysmCalendarField="true"]::up-arrow, QDateTimeEdit[pysmCalendarField="true"]::up-arrow {
    width: 0; height: 0; border-left: 3px solid transparent;
    border-right: 3px solid transparent; border-bottom: 4px solid #33FF33;
}
QDateEdit[pysmCalendarField="true"]::down-arrow, QTimeEdit[pysmCalendarField="true"]::down-arrow, QDateTimeEdit[pysmCalendarField="true"]::down-arrow {
    width: 0; height: 0; border-left: 3px solid transparent;
    border-right: 3px solid transparent; border-top: 4px solid #33FF33;
}
QCalendarWidget[pysmCalendar="true"] {
    background-color: #0A0F0A; color: #33FF33;
    border: 1px solid #1A4A1A;
}
QCalendarWidget[pysmCalendar="true"] QWidget#qt_calendar_navigationbar {
    background-color: #1A4A1A; border-bottom: 1px solid #33FF33;
}
QCalendarWidget[pysmCalendar="true"] QToolButton {
    background-color: #1A4A1A; color: #33FF33;
    border: 1px solid transparent; padding: 5px;
}
QCalendarWidget[pysmCalendar="true"] QToolButton#qt_calendar_monthbutton {
    padding-left: 8px; padding-right: 28px;
}
QCalendarWidget[pysmCalendar="true"] QToolButton#qt_calendar_monthbutton::menu-indicator {
    subcontrol-origin: padding; subcontrol-position: center right;
    right: 4px;
}
QCalendarWidget[pysmCalendar="true"] QToolButton:hover { border-color: #33FF33; }
QCalendarWidget[pysmCalendar="true"] QToolButton:pressed {
    background-color: #33FF33; color: #0A0F0A;
}
QCalendarWidget[pysmCalendar="true"] QSpinBox {
    background-color: #0A0F0A; color: #33FF33;
    border: 1px solid #33FF33; selection-background-color: #33FF33;
    selection-color: #0A0F0A;
}
QCalendarWidget[pysmCalendar="true"] QAbstractItemView:enabled {
    background-color: #0A0F0A; alternate-background-color: #050805;
    color: #33FF33; selection-background-color: #33FF33;
    selection-color: #0A0F0A; outline: 0;
}
QCalendarWidget[pysmCalendar="true"] QAbstractItemView::item:hover:!selected {
    background-color: #1A4A1A;
}
QCalendarWidget[pysmCalendar="true"] QAbstractItemView:disabled { color: #1A4A1A; }
