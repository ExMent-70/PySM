/* -----------------------------------------------------------------------------
 * themes/midnight_blue/style.qss
 *
 * Мягкая синеватая темная тема.
 * -------------------------------------------------------------------------- */

/* --- [0] ПЕРЕМЕННЫЕ ТЕМЫ --- */
@bgColorBase = #2d333b;
@bgColorContainer = #22272e;
@bgColorAlternate = #2d333b;
@bgColorHover = #373e48;
@bgColorPressed = #316dca;
@bgColorDisabled = #2d333b;
@bgColorHeader = #373e48;
@bgColorTooltip = #22272e;
@bgColorScrollbar = #22272e;
@bgColorScrollHandle = #434c58;
@bgColorScrollHandleHover = #545d68;
@bgColorMenu = #2d333b;
@bgColorDialog = #2d333b;

@textColor = #adbac7;
@textColorSecondary = #cdd5df;
@textColorDisabled = #6a7582;
@textColorOnAccent = #ffffff;
@textColorGroupBoxTitle = #cdd5df;

@borderColor = #444c56;
@borderColorGrid = #444c56;
@borderColorDirty = #d15766;
@borderColorTooltip = #545d68;

@accentColor = #316dca;
@accentColorHover = #3e81e9;
@accentColorPressed = #316dca;
@accentColorSelection = #214283;


/* --- [1] ГЛОБАЛЬНЫЕ И ОСНОВНЫЕ СТИЛИ --- */
QWidget {
    background-color: @bgColorBase;
    color: @textColor;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    border: none;
}
QLabel, QCheckBox { background-color: transparent; }
QStatusBar { background-color: @accentColor; color: @textColorOnAccent; }
QToolTip {
    background-color: @bgColorTooltip;
    color: @textColor;
    border: 1px solid @borderColorTooltip;
    padding: 5px; border-radius: 5px; opacity: 230;
}


/* --- [2] КНОПКИ (QPushButton, QToolButton) --- */
QPushButton {
    background-color: @bgColorHeader;
    color: @textColorSecondary;
    border: 1px solid #545d68;
    padding: 6px 12px; border-radius: 5px;
}
QPushButton:hover { background-color: #434c58; border-color: #6a7582; }
QPushButton:pressed {
    background-color: @accentColorPressed;
    color: @textColorOnAccent;
    border-color: @accentColorPressed;
}
QPushButton:disabled {
    background-color: @bgColorDisabled;
    color: @textColorDisabled;
}
QDialogButtonBox QPushButton { padding: 6px 20px; }


/* --- [3] ПАНЕЛЬ ИНСТРУМЕНТОВ --- */
QToolBar {
    background-color: @bgColorBase;
    border-bottom: 1px solid @borderColor;
    padding: 2px; spacing: 5px;
}
QToolBar QToolButton {
    background-color: transparent; border: 1px solid transparent; padding: 5px;
    border-radius: 5px; margin: 2px;
}
QToolBar QToolButton:hover {
    background-color: @bgColorHover;
    border: 1px solid @borderColor;
}
QToolBar QToolButton:pressed, QToolBar QToolButton:checked {
    background-color: @accentColor;
    border: 1px solid @accentColor;
}
QToolBar QToolButton[popupMode="1"] { padding-right: 20px; }
QToolBar QToolButton::menu-button {
    border: none; border-left: 1px solid @borderColor; width: 16px;
    border-top-right-radius: 5px; border-bottom-right-radius: 5px;
}
QToolBar QToolButton::menu-arrow {
    width: 0; height: 0; border-left: 3px solid transparent;
    border-right: 3px solid transparent; border-top: 2px solid @textColor;
}
QToolBar QToolButton::menu-arrow:open { border-top: none; border-bottom: 2px solid @textColor; }


/* --- [4] ПОЛЯ ВВОДА --- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: @bgColorContainer;
    border: 1px solid @borderColor;
    border-radius: 5px; padding: 4px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid @accentColor;
}
QLineEdit:disabled, QLineEdit:read-only,
QTextEdit:disabled, QTextEdit:read-only,
QPlainTextEdit:disabled, QPlainTextEdit:read-only {
    background-color: @bgColorBase;
    color: @textColorDisabled;
    border: 1px solid @borderColor;
}


/* --- [5] КОНТЕЙНЕРЫ (QGroupBox, QTabWidget, QToolBox) --- */
QGroupBox {
    background-color: @bgColorContainer;
    border: 1px solid @borderColor;
    border-radius: 6px; margin-top: 15px;
}
QGroupBox[isDirty="true"] { border: 2px solid @borderColorDirty; }
QGroupBox[isDirty="true"]::title { color: @borderColorDirty; }
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top center;
    padding: 0 5px; top: 5px; color: @textColorGroupBoxTitle;
}

QTabWidget::pane {
    background-color: @bgColorContainer;
    border: 1px solid @borderColor;
    border-radius: 6px; margin-top: -1px;
}
QTabBar::tab {
    background: @bgColorBase; color: @textColor;
    border: 1px solid @borderColor; border-bottom: none;
    padding: 7px 15px;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
}
QTabBar::tab:selected {
    background: @bgColorContainer; font-weight: bold; margin-bottom: -1px;
    color: @textColorSecondary;
}
QTabBar::tab:!selected:hover { background: @bgColorHover; }

QToolBox::tab {
    background: @bgColorHover; border: 1px solid @borderColor; border-radius: 5px;
    color: @textColorSecondary; padding: 6px; font-weight: bold;
}
QToolBox::tab:selected, QToolBox::tab:hover {
    background: @accentColor; color: @textColorOnAccent;
}
QToolBox QWidget, QToolBox QTextEdit { background-color: @bgColorContainer; color: @textColor; border: none; }


/* --- [6] СПИСКИ И ТАБЛИЦЫ (QTreeView, QListWidget, QTableWidget) --- */
QTreeView, QListWidget, QTableWidget {
    background-color: @bgColorContainer;
    alternate-background-color: @bgColorAlternate;
    border: 1px solid @borderColor; border-radius: 5px;
}
QTreeView::item:hover, QListWidget::item:hover { background-color: @bgColorHover; }
QTreeView::item:selected, QListWidget::item:selected {
    background-color: @accentColorSelection;
    color: @textColorOnAccent;
}

QHeaderView::section {
    background-color: @bgColorHeader; padding: 5px; border: none;
    font-weight: normal; border-bottom: 1px solid @borderColor;
}
QHeaderView::section:!last-of-type { border-right: 1px solid @borderColor; }

QTableWidget { gridline-color: @borderColorGrid; }
QTableWidget::item { padding: 2px; border: none; color: @textColor; }
QTableWidget::item:selected { background-color: @accentColorSelection; color: @textColorOnAccent; }
QTableWidget QWidget { background-color: transparent; padding: 0px; margin: 0px; }
QTableWidget QPushButton { padding: 2px 5px; font-weight: normal; margin: 1px; }
QTableWidget QLineEdit, QTableWidget QComboBox, QTableWidget QDateEdit, QTableWidget QDateTimeEdit {
    border: none; background-color: transparent; border-radius: 0px; color: @textColor;
}
QTableWidget QLineEdit:focus, QTableWidget QComboBox:focus, QTableWidget QDateEdit:focus, QTableWidget QDateTimeEdit:focus {
    background-color: @bgColorContainer;
    border: 1px solid @accentColor;
}



/* --- [6.1] СТИЛИ ДЛЯ РЕДАКТОРА КЛАСТЕРОВ --- */
/* Применяем стили к виджетам по их уникальным именам */
QListWidget#clusterListWidget, QListWidget#imageListWidget {
    background-color: @bgColorContainer;
    alternate-background-color: @bgColorAlternate;
    border: 1px solid @borderColor;
    border-radius: 5px;
    padding: 5px; /* Небольшой отступ для элементов */
}

/* Стиль для одного элемента списка (item) */
QListWidget#clusterListWidget::item, QListWidget#imageListWidget::item {
    outline: 0;
    border: 1px solid transparent; /* Прозрачная рамка по умолчанию */
    border-radius: 5px;
    margin: 2px;
    /* Убираем стандартное выделение, т.к. делегат рисует свое содержимое */
    background-color: transparent;
    color: transparent;
}

/* Стиль при наведении курсора */
QListWidget#clusterListWidget::item:hover, QListWidget#imageListWidget::item:hover {
    background-color: @bgColorHover;
    border-color: @accentColor;
}

/* Стиль при выделении элемента */
QListWidget#clusterListWidget::item:selected, QListWidget#imageListWidget::item:selected {
    background-color: @accentColor;
    border-color: @accentColor;
    color: @textColorOnAccent; /* Цвет текста для выделенных элементов */
}


/* --- [7] ВЫПАДАЮЩИЕ СПИСКИ (QComboBox) --- */
QComboBox {
    background-color: @bgColorContainer;
    border: 1px solid @borderColor;
    border-radius: 5px; padding: 4px;
}
QComboBox:focus { border: 1px solid @accentColor; }
QComboBox::drop-down {
    border-left: 1px solid @borderColor;
    border-top-right-radius: 5px; border-bottom-right-radius: 5px;
}
QComboBox::down-arrow {
    width: 0; height: 0; border-left: 4px solid transparent;
    border-right: 4px solid transparent; border-top: 4px solid @textColor;
}
QComboBox::down-arrow:on { border-top: none; border-bottom: 4px solid @textColor; }
QComboBox QAbstractItemView {
    background-color: @bgColorContainer;
    border: 1px solid @borderColor; outline: none;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; }
QComboBox QAbstractItemView::item:selected, QComboBox QAbstractItemView::item:hover {
    background-color: @accentColor;
    color: @textColorOnAccent;
}


/* --- [8] ЧЕКБОКСЫ И ПРОГРЕСС-БАРЫ --- */
QCheckBox::indicator { border: 1px solid #6a7582; border-radius: 4px; }
QCheckBox::indicator:unchecked { background-color: @bgColorBase; }
QCheckBox::indicator:unchecked:hover { border-color: @accentColor; }
QCheckBox::indicator:checked { background-color: @accentColor; }
QCheckBox::indicator:checked:hover { background-color: @accentColorHover; }

QProgressBar {
    border: 1px solid @borderColor; border-radius: 5px;
    text-align: center; color: @textColorSecondary; background-color: @bgColorBase;
}
QProgressBar::chunk { background-color: @accentColor; border-radius: 4px; }


/* --- [9] ПОЛОСЫ ПРОКРУТКИ (QScrollBar) --- */
QScrollBar:vertical { border: none; background: @bgColorScrollbar; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: @bgColorScrollHandle; min-height: 25px; border-radius: 6px; }
QScrollBar::handle:vertical:hover { background: @bgColorScrollHandleHover; }
QScrollBar::handle:vertical:pressed { background: @accentColorPressed; }
QScrollBar:horizontal { border: none; background: @bgColorScrollbar; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: @bgColorScrollHandle; min-width: 25px; border-radius: 6px; }
QScrollBar::handle:horizontal:hover { background: @bgColorScrollHandleHover; }
QScrollBar::handle:horizontal:pressed { background: @accentColorPressed; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0px; width: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }


/* --- [10] МЕНЮ (QMenu) --- */
QMenu { background-color: @bgColorMenu; border: 1px solid @borderColor; padding: 5px; }
QMenu::item { padding: 8px 25px; border-radius: 4px; }
QMenu::item:selected { background-color: @accentColor; color: @textColorOnAccent; }


/* --- [11] ДИАЛОГОВЫЕ ОКНА --- */
QDialog { background-color: @bgColorDialog; }
QMessageBox, QFileDialog { background-color: @bgColorDialog; }
QMessageBox QLabel { background-color: transparent; color: @textColor; }
QDialogButtonBox QPushButton { padding: 6px 20px; }

QDialog#JsonEditorDialog, QDialog#MultilineTextDialog, QInputDialog {
    background-color: @bgColorDialog; color: @textColor;
}
QDialog#JsonEditorDialog QPlainTextEdit, QDialog#MultilineTextDialog QPlainTextEdit,
QInputDialog QPlainTextEdit, QInputDialog QLineEdit {
    background-color: @bgColorContainer; color: @textColor;
    border: 1px solid @borderColor;
    font-family: "Consolas", "Courier New", monospace;
}
QDialog#JsonEditorDialog QPushButton, QDialog#MultilineTextDialog QPushButton,
QInputDialog QPushButton {
    background-color: @bgColorHeader; color: @textColorSecondary;
    border: 1px solid #545d68;
}
QDialog#JsonEditorDialog QPushButton:hover, QDialog#MultilineTextDialog QPushButton:hover,
QInputDialog QPushButton:hover {
    background-color: #434c58;
}